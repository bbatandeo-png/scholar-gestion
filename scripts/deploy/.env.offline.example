PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/scolar-gestion?replicaSet=rs0
SESSION_SECRET=changez-cette-valeur-avant-livraison
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@scolar-gestion.local
ADMIN_PASSWORD=Admin123!
# Recommande une fois l'ecole en production (donnees reelles deja saisies) :
# le seed reste idempotent sur l'ecole/admin, mais evite de le relancer par
# prudence a chaque demarrage sur un poste client actif.
# SEED_ON_START=false
# Off par defaut - une fois sur "on", l'ecole demarre bloquee en lecture
# seule tant qu'aucun code n'a ete colle dans Licence (c'est voulu : voir
# docs/deploiement-offline.md, section "Licence et activation", pour le
# parcours complet - generer LICENSE_SECRET ci-dessous, livrer l'exe, puis
# generer et envoyer le premier code via `npm run license -- generate`
# cote developpeur une fois le code d'installation du client recu).
# LICENSE_ENFORCEMENT=on
# Propre a CETTE ecole - generer une valeur aleatoire distincte pour chaque
# client, jamais la meme sur deux postes :
#   npm run license -- new-secret "<nom du client>"
# (ou directement `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# si vous gerez le registre vous-meme). Sans cette valeur, aucun code
# d'activation ne peut etre genere pour cette ecole.
# LICENSE_SECRET=
