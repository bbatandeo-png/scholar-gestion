PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/scolar-gestion?replicaSet=rs0
SESSION_SECRET=changez-cette-valeur-avant-livraison
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@scolar-gestion.local
ADMIN_PASSWORD=Admin123!
# Recommande une fois l'ecole en production (donnees reelles deja saisies) :
# le seed reste idempotent sur l'ecole/admin, mais evite de le relancer par
# prudence a chaque demarrage sur un poste client actif.
# SEED_ON_START=false
# Off par defaut - ne pas activer sans avoir prealablement genere et applique
# un premier code de licence pour cette ecole (bouton "Generer et appliquer"
# dans /platform/ecoles/<id>/edit, ou a defaut generate-license.js),
# sinon l'application se bloquera en lecture seule des le premier lancement.
# LICENSE_ENFORCEMENT=on
# Propre a CETTE ecole - generer une valeur aleatoire distincte pour chaque
# client (ex. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`),
# jamais la meme sur deux postes. Sans cette valeur, le bouton "Generer et
# appliquer" de /platform/ecoles reste indisponible sur ce poste.
# LICENSE_SECRET=
