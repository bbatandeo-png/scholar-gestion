# Off by default - set to "on" only once a paid license period has been
# decided for this specific install, otherwise the /licence checks never
# run and nothing gets blocked. See src/licensing/.
# LICENSE_ENFORCEMENT=on
# Unique per install - generate a fresh random value per client (e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`),
# never reuse one across clients. Required for /platform/ecoles' local
# "Generer et appliquer" button to work at all; absent = generation disabled
# on this instance (the expected state for an online tracking-only deploy).
# LICENSE_SECRET=