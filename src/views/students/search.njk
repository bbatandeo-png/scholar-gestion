{% extends "layout.njk" %}
{% import "partials/legend.njk" as legend %}
{% block content %}
  <section class="panel">
    <div class="topbar">
      <div class="topbar-heading">
        <div class="topbar-title-row">
          <h2>Anciens élèves</h2>
          <p class="muted" id="archived-summary" aria-live="polite">{{ pagination.total }} résultat(s) • page {{ pagination.page }} / {{ pagination.totalPages }}</p>
        </div>
      </div>

      <div class="topbar-actions">
        <form method="get" action="/students/search" class="inline-form" id="search-archived" role="search" data-live-search="#archived-summary, #archived-results">
          <label class="search-controls">
            <input type="search" name="q" value="{{ query }}" placeholder="Matricule, nom, prénom, quartier…" aria-label="Rechercher un ancien élève" autocomplete="off" />
            <button type="submit" class="button btn-icon icon-search">Rechercher</button>
          </label>
        </form>
      </div>
    </div>

    <p class="muted">Élèves sans inscription active sur l'année ouverte : partis, archivés ou pas encore réinscrits.</p>
    <div id="archived-results">
    <div class="table-shell">
      <table class="table-report js-sortable" data-no-filter>
        <thead>
          <tr>
            <th class="sortable" data-column-index="0" data-sort-type="text">Matricule</th>
            <th class="sortable" data-column-index="1" data-sort-type="text">Nom</th>
            <th class="sortable" data-column-index="2" data-sort-type="text">Statut</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {% for student in students %}
            <tr>
              <td>{{ student.matricule }}</td>
              <td>{{ student.lastname }} {{ student.firstname }}</td>
              <td>{% set value = student.status %}{% set group = 'studentStatus' %}{% include "partials/status-badge.njk" %}</td>
              <td class="actions">
                <a class="button secondary btn-sm btn-icon icon-view" href="/students/{{ student._id }}">Fiche</a>
                {% if currentUser and currentUser.role in ['super_admin', 'secretariat'] %}<a class="button" href="/students/{{ student._id }}/reenroll">Réinscrire</a>{% endif %}
              </td>
            </tr>
          {% else %}
            <tr><td colspan="4">Aucun dossier correspondant.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {{ legend.render(['studentStatus']) }}
    <div class="pagination-row">
      <form method="get" action="/students/search" class="inline-form">
        <input type="hidden" name="q" value="{{ query }}" />
        <input type="hidden" name="pageSize" value="{{ pagination.pageSize }}" />
        <input type="hidden" name="page" value="{{ pagination.prevPage }}" />
        <button type="submit" class="secondary btn-sm btn-icon icon-prev" {% if not pagination.hasPrev %}disabled{% endif %}>Précédent</button>
      </form>
      <span class="muted">Page {{ pagination.page }} sur {{ pagination.totalPages }}</span>
      <form method="get" action="/students/search" class="inline-form">
        <input type="hidden" name="q" value="{{ query }}" />
        <input type="hidden" name="pageSize" value="{{ pagination.pageSize }}" />
        <input type="hidden" name="page" value="{{ pagination.nextPage }}" />
        <button type="submit" class="secondary btn-sm btn-icon icon-next" {% if not pagination.hasNext %}disabled{% endif %}>Suivant</button>
      </form>
    </div>
    </div>
  </section>
{% endblock %}
