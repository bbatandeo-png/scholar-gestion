{% extends "layout.njk" %}
{% import "partials/legend.njk" as legend %}
{% block content %}
  <section class="panel">
    <div class="topbar">
      <div class="topbar-heading">
        <div class="topbar-title-row">
          <h2>Doublons de noms</h2>
          <p class="muted">{{ groups.length }} groupe(s) d'élèves partageant exactement le même nom et prénoms.</p>
        </div>
      </div>
      <div class="topbar-actions">
        <a class="button secondary" href="/students">Retour aux élèves</a>
      </div>
    </div>
    <p class="muted">Un nom partagé n'est pas forcément une erreur (de vrais homonymes existent) - cette liste sert à vérifier au cas par cas, à titre d'information seulement.</p>

    {% if groups.length %}
      {% for duplicateGroup in groups %}
        <div class="panel form-section top-gap">
          <h3>{{ duplicateGroup._id.lastname | upper }} {{ duplicateGroup._id.firstname | upper }} <span class="muted">({{ duplicateGroup.count }} dossiers)</span></h3>
          <div class="table-shell">
            <table class="table-report">
              <thead>
                <tr>
                  <th>N°</th>
                  <th>Matricule</th>
                  <th>Nom</th>
                  <th>Prénoms</th>
                  <th>Statut</th>
                  <th>Créé le</th>
                  {% if activeModules and activeModules.finance %}
                    <th>Total payé</th>
                    <th>Solde du</th>
                  {% endif %}
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {% for student in duplicateGroup.students %}
                  <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ student.matricule }}</td>
                    <td>{{ student.lastname }}</td>
                    <td>{{ student.firstname }}</td>
                    <td>{% set value = student.status %}{% set group = 'studentStatus' %}{% include "partials/status-badge.njk" %}</td>
                    <td>{{ student.createdAt | formatDate }}</td>
                    {% if activeModules and activeModules.finance %}
                      <td>{{ student.financial.totalPaid | money }}</td>
                      <td>{{ student.financial.balanceDue | money }}</td>
                    {% endif %}
                    <td class="actions">
                      <a class="button secondary btn-sm btn-icon icon-view" href="/students/{{ student._id }}">Fiche</a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      {% endfor %}
      {{ legend.render(['studentStatus']) }}
    {% else %}
      <p class="notice notice-info top-gap">Aucun doublon de nom detecte.</p>
    {% endif %}
  </section>
{% endblock %}
