{% extends "layout.njk" %}
{% import "partials/legend.njk" as legend %}
{% block content %}
  <section class="stack">
    {# Import et creation : reserves au guichet (super admin, secretariat). #}
    {% if currentUser and currentUser.role in ['super_admin', 'secretariat'] %}
    <div class="panel">
      <h2>Importer des élèves</h2>
      <p class="muted">Pour une école qui a déjà ses élèves dans un fichier - importez en masse les mêmes champs que le formulaire de création ci-dessous (matricule, nom, prénoms, sexe, date et lieu de naissance, quartier, et les responsables si renseignes).</p>
      <div class="toolbar compact-actions">
        <a class="button secondary btn-icon icon-export" href="/students/import-template">Télécharger le modèle (Excel)</a>
      </div>
      <form method="post" action="/students/import" enctype="multipart/form-data" class="toolbar compact-actions top-gap">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="file" name="file" accept=".xlsx,.xls" required />
        <button type="submit" class="button">Importer</button>
      </form>
    </div>

    <div class="panel">
      <h2>Créer un élève</h2>
      <form method="post" action="/students" enctype="multipart/form-data" class="stack" id="createStudentForm">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <div class="form-grid">
          <label>Matricule
            <input name="matricule" placeholder="Laisser vide pour generation automatique" />
          </label>
          <label>Nom<input name="lastname" required /></label>
          <label>Prénoms<input name="firstname" required /></label>
          <label>Sexe
            <select name="gender" required>
              <option value="">Sélectionner</option>
              <option value="M">M</option>
              <option value="F">F</option>
            </select>
          </label>
          <label>Date de naissance<input type="date" name="birthDate" /></label>
          <label>Lieu de naissance<input name="birthPlace" /></label>
          <label>Quartier<input name="district" /></label>
          <label>Classe
            <select name="levelId" required>
              <option value="" selected>Choisir une classe</option>
              {% for level in levels %}
                <option value="{{ level._id }}">{{ level.label }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Photo (pour la carte scolaire)
            <input type="file" name="photo" accept="image/png,image/jpeg,image/webp,image/gif" />
          </label>
        </div>

        {% if activeModules and activeModules.finance and currentUser and (currentUser.role == 'super_admin' or currentUser.role == 'secretariat') %}
          <h3>Paiement a l'inscription <span class="muted">{{ '(obligatoire)' if registrationPaymentRequired else '(optionnel)' }}</span></h3>
          <p id="createFeeHint" class="muted">Choisissez une classe pour voir le montant de l'inscription.</p>
          <div class="form-grid">
            <label>Montant payé maintenant
              <input type="number" name="paymentAmount" id="createPaymentAmount" min="{{ '1' if registrationPaymentRequired else '0' }}" placeholder="0" {% if registrationPaymentRequired %}required{% endif %} />
            </label>
            <label>Mode de paiement
              <select name="paymentMethod">
                {% for key, meta in ENUM_META.paymentMethod %}
                  <option value="{{ key }}">{{ meta.label }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Référence<input name="paymentReference" /></label>
          </div>
        {% endif %}

        <h3>Responsables (parents / tuteur)</h3>
        <p class="muted">Renseignez au moins les informations disponibles (nom, prénoms, contact).</p>
        <div class="form-grid">
          <input type="hidden" name="guardians[0][type]" value="father" />
          <label>Nom complet du père
            <input name="guardians[0][fullname]" placeholder="Nom complet du père" />
          </label>
          <label>Contact du père
            <input name="guardians[0][phone]" placeholder="Téléphone du père" />
          </label>
          <label>Adresse du père
            <input name="guardians[0][address]" placeholder="Adresse du père" />
          </label>

          <input type="hidden" name="guardians[1][type]" value="mother" />
          <label>Nom complet de la mère
            <input name="guardians[1][fullname]" placeholder="Nom complet de la mère" />
          </label>
          <label>Contact de la mère
            <input name="guardians[1][phone]" placeholder="Téléphone de la mère" />
          </label>
          <label>Adresse de la mère
            <input name="guardians[1][address]" placeholder="Adresse de la mère" />
          </label>

          <input type="hidden" name="guardians[2][type]" value="tutor" />
          <label>Nom complet du tuteur
            <input name="guardians[2][fullname]" placeholder="Nom complet du tuteur" />
          </label>
          <label>Contact du tuteur
            <input name="guardians[2][phone]" placeholder="Téléphone du tuteur" />
          </label>
          <label>Adresse du tuteur
            <input name="guardians[2][address]" placeholder="Adresse du tuteur" />
          </label>
        </div>

        <p class="muted">Le matricule sera généré automatiquement si le champ reste vide.</p>
        <button type="submit" class="btn-lg btn-icon icon-save" id="createStudentSubmit">Créer le dossier</button>
      </form>
      {% set dialogId = 'duplicateNameDialog' %}
      {% include "partials/duplicate-name-confirm-dialog.njk" %}
    </div>

    <script>
      // Fee hint + dynamic button label for "Creer un eleve" - mirrors the
      // enrollment form's own version (see enrollments/index.njk). The class
      // chosen here doubles as an immediate enrollment (StudentsController.
      // create()), so the same "what will this cost" hint applies.
      (() => {
        const feesByLevel = {{ (feesByLevel or {}) | dump | safe }};
        const level = document.querySelector('#createStudentForm select[name="levelId"]');
        const hint = document.getElementById('createFeeHint');
        const amount = document.getElementById('createPaymentAmount');
        const submitButton = document.getElementById('createStudentSubmit');
        if (!level) return;

        const refresh = () => {
          if (hint) {
            const fee = feesByLevel[level.value];
            hint.textContent = !level.value
              ? 'Choisissez une classe pour voir le montant de l\'inscription.'
              : !fee
                ? 'Aucun frais defini pour cette classe.'
                : 'Inscription : ' + formatMoney(fee.registrationFee) + ' — Écolage : ' + formatMoney(fee.tuitionFee) +
                  ' — Total à payer : ' + formatMoney(fee.registrationFee + fee.tuitionFee) + ' (hors impayés reportés)';
          }
          if (submitButton) {
            submitButton.textContent = Number(amount?.value || 0) > 0
              ? "Créer le dossier et enregistrer le paiement"
              : 'Créer le dossier';
          }
        };
        level.addEventListener('change', refresh);
        amount?.addEventListener('input', refresh);
        refresh();
      })();

      // Popup de confirmation (dialog stylee, voir
      // partials/duplicate-name-confirm-dialog.njk) si un eleve du meme nom
      // existe deja - n'empeche jamais la creation (de vrais homonymes
      // existent), demande juste de confirmer.
      confirmDuplicateNameBeforeSubmit(
        document.getElementById('createStudentForm'),
        document.getElementById('duplicateNameDialog'),
        '/students/check-duplicate',
      );
    </script>
    {% endif %}

    <div class="panel">
      <div class="topbar">
        <div class="topbar-heading">
          <div class="topbar-title-row">
            <h2>Élèves</h2>
            <p class="muted" id="students-summary" aria-live="polite">{{ pagination.total }} élève(s) • page {{ pagination.page }} / {{ pagination.totalPages }}</p>
          </div>
        </div>

        <div class="topbar-actions student-list-actions">
          <form method="get" action="/students" class="inline-form" id="main-search" role="search" data-live-search="#students-summary, #students-export, #students-results">
            <label class="search-controls">
              <input type="search" name="q" value="{{ query }}" placeholder="Rechercher par nom, prénom ou matricule…" aria-label="Rechercher un élève par nom, prénom ou matricule" autocomplete="off" />
              <button type="submit" class="button btn-icon icon-search">Rechercher</button>
            </label>
          </form>

          <a class="button secondary" href="/students/search">Anciens élèves</a>
          <a class="button secondary" href="/students/duplicates">Doublons</a>

          <form method="get" action="/students/export" class="inline-form" id="students-export">
            <input type="hidden" name="q" value="{{ query }}" />
            <input type="hidden" name="levelId" value="{{ filters.levelId }}" />
            <input type="hidden" name="status" value="{{ filters.status }}" />
            <input type="hidden" name="matricule" value="{{ filters.matricule }}" />
            <input type="hidden" name="schoolYearId" value="{{ filters.schoolYearId }}" />
            <button type="submit" class="button secondary btn-icon icon-export">Exporter</button>
          </form>
        </div>
      </div>

      <form method="get" action="/reports/nominal-roll/pdf" target="_blank" class="toolbar compact-actions page-toolbar">
        <label class="field-inline nominal-roll-field">
          Liste nominative de la classe
          <select name="levelId" required>
            <option value="">Sélectionner une classe</option>
            {% for level in levels %}
              <option value="{{ level._id }}">{{ level.label }}</option>
            {% endfor %}
          </select>
        </label>
        <button type="submit" class="button secondary btn-icon icon-export" {% if not openSchoolYear %}disabled{% endif %}>
          Ouvrir le PDF
        </button>
        {% if openSchoolYear %}
          <span class="muted">Année scolaire : {{ openSchoolYear.label }}</span>
        {% else %}
          <span class="notice notice-warning">Ouvrez une année scolaire avant d'imprimer la liste.</span>
        {% endif %}
      </form>

      <div id="students-results">
      <div class="table-shell">
        <table class="table-report js-sortable" data-no-filter>
          <thead>
            <tr>
              <th>N°</th>
              <th class="sortable" data-column-index="1" data-sort-type="text">Matricule</th>
              <th class="sortable" data-column-index="2" data-sort-type="text">Nom complet</th>
              <th class="sortable" data-column-index="3" data-sort-type="text">Niveau</th>
              <th class="sortable" data-column-index="4" data-sort-type="text">Statut</th>
              <th>Date d'enregistrement</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for student in students %}
              <tr>
                <td>{{ (pagination.page - 1) * pagination.pageSize + loop.index }}</td>
                <td>{{ student.matricule }}</td>
                <td>{{ student.lastname }} {{ student.firstname }}</td>
                <td>{{ student.currentLevel }}</td>
                <td>{% set value = student.status %}{% set group = 'studentStatus' %}{% include "partials/status-badge.njk" %}</td>
                <td>{{ student.createdAt | formatDate }}</td>
                <td>
                  <div class="table-actions">
                    <a class="button secondary btn-sm btn-icon icon-view" href="/students/{{ student._id }}">Voir</a>
                    {% if activeModules and activeModules.finance %}
                      <a class="button btn-sm btn-icon icon-pay" href="/enrollments?studentId={{ student._id }}">Payer</a>
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="7">Aucun élève trouvé.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {{ legend.render(['studentStatus']) }}
      <div class="pagination-row">
        <form method="get" action="/students" class="inline-form">
          <input type="hidden" name="q" value="{{ query }}" />
          <input type="hidden" name="levelId" value="{{ filters.levelId }}" />
          <input type="hidden" name="status" value="{{ filters.status }}" />
          <input type="hidden" name="matricule" value="{{ filters.matricule }}" />
          <input type="hidden" name="schoolYearId" value="{{ filters.schoolYearId }}" />
          <input type="hidden" name="pageSize" value="{{ pagination.pageSize }}" />
          <input type="hidden" name="page" value="{{ pagination.prevPage }}" />
          <button type="submit" class="secondary btn-sm btn-icon icon-prev" {% if not pagination.hasPrev %}disabled{% endif %}>Précédent</button>
        </form>
        <span class="muted">Page {{ pagination.page }} sur {{ pagination.totalPages }}</span>
        <form method="get" action="/students" class="inline-form">
          <input type="hidden" name="q" value="{{ query }}" />
          <input type="hidden" name="levelId" value="{{ filters.levelId }}" />
          <input type="hidden" name="status" value="{{ filters.status }}" />
          <input type="hidden" name="matricule" value="{{ filters.matricule }}" />
          <input type="hidden" name="schoolYearId" value="{{ filters.schoolYearId }}" />
          <input type="hidden" name="pageSize" value="{{ pagination.pageSize }}" />
          <input type="hidden" name="page" value="{{ pagination.nextPage }}" />
          <button type="submit" class="secondary btn-sm btn-icon icon-next" {% if not pagination.hasNext %}disabled{% endif %}>Suivant</button>
        </form>
      </div>
      </div>
    </div>
  </section>
{% endblock %}
