{% extends "layout.njk" %}
{% import "partials/legend.njk" as legend %}
{% block content %}
  <section class="enrollment-layout">
    {% if importPaidStudentsEnabled and not schoolYearContext.isHistorical %}
      <div class="panel import-paid-students-panel">
        <h2>Importer des élèves déjà payés</h2>
        <p class="muted">Pour une migration depuis un ancien système : crée l'élève, l'inscrit dans la classe indiquée et enregistre le montant déjà payé tel quel (sans recalcul par rapport au barème de frais). Activable/désactivable dans Paramètres.</p>
        <div class="toolbar compact-actions">
          <a class="button secondary btn-icon icon-export" href="/enrollments/import-template">Télécharger le modèle (Excel)</a>
        </div>
        <form method="post" action="/enrollments/import" enctype="multipart/form-data" class="toolbar compact-actions top-gap">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="file" name="file" accept=".xlsx,.xls" required />
          <button type="submit" class="button">Importer</button>
        </form>
      </div>
    {% endif %}

    {% if not schoolYearContext.isHistorical %}<div class="panel">
      <h2 id="enrollFormTitle">Creer une inscription</h2>
      <p id="alreadyEnrolledNotice" class="notice notice-info" hidden></p>
      <form method="post" action="/enrollments" class="stack" id="enrollForm">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <div class="form-grid">
          <label>Eleve
            <div class="autocomplete-wrap">
              <input
                type="text"
                id="studentSearchInput"
                autocomplete="off"
                required
                placeholder="Rechercher un eleve (nom, prenom, matricule)..."
                role="combobox"
                aria-expanded="false"
                aria-autocomplete="list"
                aria-controls="studentSearchResults"
              />
              <div id="studentSearchResults" class="autocomplete-results" role="listbox" hidden></div>
            </div>
            <p id="studentSearchStatus" class="search-status muted"></p>
            <p id="studentClassInfo" class="student-class-info" hidden></p>
            <input type="hidden" name="studentId" id="studentIdSelect" />
          </label>
          <label>Annee
            <input value="{{ selectedYear.label }}" disabled />
            <input type="hidden" name="schoolYearId" value="{{ selectedYear._id }}" />
          </label>
          <label id="levelField">Niveau
            <input type="text" id="levelDisplay" disabled hidden />
            <select name="levelId" required>
              <option value="" selected>Choisir un niveau</option>
              {% for level in levels %}
                <option value="{{ level._id }}">{{ level.label }}</option>
              {% endfor %}
            </select>
          </label>
          <label id="typeField">Type
            <select name="type" required>
              <option value="" selected>Choisir un type</option>
              {% for key, meta in ENUM_META.enrollmentType %}
                <option value="{{ key }}" title="{{ meta.description }}">{{ meta.label }}</option>
              {% endfor %}
            </select>
          </label>
          <label id="discountField">Reduction de frais (optionnel)
            <input type="number" name="discountAmount" min="0" step="0.01" placeholder="0.00" />
          </label>
        </div>

        {% if activeModules and activeModules.finance and currentUser and (currentUser.role == 'super_admin' or currentUser.role == 'secretariat') %}
          <h3 id="paymentSectionTitle">Paiement a l'inscription <span class="muted">(optionnel)</span></h3>
          <p id="feeHint" class="muted">Choisissez un niveau pour voir le montant de l'inscription.</p>
          <div class="form-grid">
            <label>Montant paye maintenant
              <input type="number" name="paymentAmount" id="paymentAmount" min="0" placeholder="0" />
            </label>
            <label>Mode de paiement
              <select name="paymentMethod" id="paymentMethodSelect">
                {% for key, meta in ENUM_META.paymentMethod %}
                  <option value="{{ key }}">{{ meta.label }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Reference<input name="paymentReference" /></label>
          </div>
        {% endif %}
        <button type="submit" class="btn-lg btn-icon icon-save" id="enrollSubmit">Creer l inscription</button>
      </form>
      {% set dialogId = 'enrollPaymentConfirmDialog' %}
      {% include "partials/payment-confirm-dialog.njk" %}
      {{ legend.render(['enrollmentType', 'enrollmentStatus']) }}
    </div>{% endif %}

    <div class="panel status-panel">
      <div class="panel-heading">
        <div>
          <h2>Situation de l eleve</h2>
          <p class="muted">Aperçu instantané pour décider de l inscription ou du règlement à prévoir.</p>
        </div>
        <span id="studentFinancialBadge" class="badge badge-neutral">En attente</span>
      </div>

      <div id="studentFinancialStatus" class="status-empty stack">
        <p class="muted">Selectionne un eleve pour voir son etat financier.</p>
      </div>
    </div>

    <div class="panel enrollment-list-panel">
      <div class="panel-heading">
        <div>
          <h2>Liste des inscriptions</h2>
          <p class="muted">{{ pagination.total }} inscription(s) • page {{ pagination.page }} / {{ pagination.totalPages }}</p>
        </div>
        <a class="button secondary btn-icon icon-export" href="/enrollments/export">Exporter Excel</a>
      </div>
      <form method="get" action="/enrollments" class="table-filter" role="search">
        <input type="hidden" name="pageSize" value="{{ pagination.pageSize }}" />
        <input type="search" name="q" value="{{ searchQuery }}" placeholder="Rechercher : nom, prénom, matricule, niveau…" aria-label="Rechercher dans les inscriptions" />
        <button type="submit" class="btn-sm btn-icon icon-search">Rechercher</button>
        {% if searchQuery %}<a class="button secondary btn-sm" href="/enrollments">Effacer</a>{% endif %}
      </form>
      {% if searchQuery %}<p class="muted">{{ pagination.total }} résultat(s) pour « {{ searchQuery }} ».</p>{% endif %}
      <div class="table-shell">
        <table class="table-report" data-no-filter>
          <thead><tr><th>N°</th><th>Eleve</th><th>Date d'enregistrement</th><th>Annee</th><th>Niveau</th><th>Statut</th><th></th></tr></thead>
          <tbody>
            {% for item in enrollments %}
              <tr>
                <td>{{ (pagination.page - 1) * pagination.pageSize + loop.index }}</td>
                <td>{{ item.studentSnapshot.lastname if item.studentSnapshot else item.studentId.lastname }} {{ item.studentSnapshot.firstname if item.studentSnapshot else item.studentId.firstname }}</td>
                <td>{{ item.createdAt | formatDate }}</td>
                <td>{{ item.schoolYearId.label if item.schoolYearId }}</td>
                <td>{{ item.levelSnapshot.label if item.levelSnapshot else item.levelId.label }}</td>
                <td>{% set value = item.status %}{% set group = 'enrollmentStatus' %}{% include "partials/status-badge.njk" %}</td>
                <td>
                  <div class="table-actions">
                    <a class="button secondary btn-sm btn-icon icon-view" href="/enrollments/{{ item._id }}">Voir</a>
                    <a class="button btn-sm" href="/enrollments/{{ item._id }}#modifier">Modifier</a>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="7">{{ 'Aucune inscription ne correspond à cette recherche.' if searchQuery else 'Aucune inscription.' }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="pagination-row">
        <form method="get" action="/enrollments" class="inline-form">
          <input type="hidden" name="pageSize" value="{{ pagination.pageSize }}" />
          <input type="hidden" name="q" value="{{ searchQuery }}" />
          <input type="hidden" name="page" value="{{ pagination.prevPage }}" />
          <button type="submit" class="secondary btn-sm btn-icon icon-prev" {% if not pagination.hasPrev %}disabled{% endif %}>Precedent</button>
        </form>
        <span class="muted">Page {{ pagination.page }} sur {{ pagination.totalPages }}</span>
        <form method="get" action="/enrollments" class="inline-form">
          <input type="hidden" name="pageSize" value="{{ pagination.pageSize }}" />
          <input type="hidden" name="q" value="{{ searchQuery }}" />
          <input type="hidden" name="page" value="{{ pagination.nextPage }}" />
          <button type="submit" class="secondary btn-sm btn-icon icon-next" {% if not pagination.hasNext %}disabled{% endif %}>Suivant</button>
        </form>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const select = document.getElementById('studentIdSelect');
      const form = select?.closest('form');
      const searchInput = document.getElementById('studentSearchInput');
      const searchResults = document.getElementById('studentSearchResults');
      const searchStatus = document.getElementById('studentSearchStatus');
      const container = document.getElementById('studentFinancialStatus');
      const badge = document.getElementById('studentFinancialBadge');

      if (!select || !form || !searchInput || !searchResults || !searchStatus || !container || !badge) {
        return;
      }

      let debounceTimer;
      let requestController;
      let activeIndex = -1;
      let currentItems = [];

      const closeResults = () => {
        searchResults.hidden = true;
        searchInput.setAttribute('aria-expanded', 'false');
        searchInput.removeAttribute('aria-activedescendant');
        activeIndex = -1;
      };

      const setActiveResult = (index) => {
        const options = Array.from(searchResults.querySelectorAll('[role="option"]'));
        options.forEach((option) => option.classList.remove('is-active'));
        if (!options.length) return;
        activeIndex = Math.max(0, Math.min(index, options.length - 1));
        const activeOption = options[activeIndex];
        activeOption.classList.add('is-active');
        activeOption.scrollIntoView({ block: 'nearest' });
        searchInput.setAttribute('aria-activedescendant', activeOption.id);
      };

      const chooseStudent = (student) => {
        select.value = student.id;
        searchInput.value = student.label;
        searchInput.setCustomValidity('');
        searchStatus.textContent = '';
        closeResults();
        select.dispatchEvent(new Event('change'));
      };

      const renderResults = (items) => {
        searchStatus.classList.remove('is-loading');
        currentItems = items;
        searchResults.replaceChildren();
        activeIndex = -1;

        if (!items.length) {
          searchStatus.textContent = 'Aucun eleve trouve.';
          closeResults();
          return;
        }

        items.forEach((student, index) => {
          const option = document.createElement('button');
          option.type = 'button';
          option.id = `student-option-${index}`;
          option.className = 'autocomplete-option';
          option.setAttribute('role', 'option');
          option.textContent = student.label;
          option.addEventListener('mousedown', (event) => event.preventDefault());
          option.addEventListener('click', () => chooseStudent(student));
          searchResults.appendChild(option);
        });

        searchStatus.textContent = `${items.length} resultat${items.length > 1 ? 's' : ''}.`;
        searchResults.hidden = false;
        searchInput.setAttribute('aria-expanded', 'true');
      };

      const searchStudents = async () => {
        const query = searchInput.value.trim();
        if (query.length < 3) {
          requestController?.abort();
          searchStatus.classList.remove('is-loading');
          searchStatus.textContent = query.length
            ? 'Saisissez au moins 3 caracteres.'
            : '';
          closeResults();
          return;
        }

        requestController?.abort();
        requestController = new AbortController();
        searchStatus.textContent = 'Recherche en cours...';
        searchStatus.classList.add('is-loading');
        closeResults();

        try {
          const response = await fetch(
            `/students/autocomplete?q=${encodeURIComponent(query)}&limit=25`,
            { headers: { Accept: 'application/json' }, signal: requestController.signal },
          );
          if (!response.ok) throw new Error('Recherche indisponible');
          const payload = await response.json();
          renderResults(Array.isArray(payload.items) ? payload.items : []);
        } catch (error) {
          if (error.name !== 'AbortError') {
            searchStatus.classList.remove('is-loading');
            searchStatus.textContent = 'Impossible de rechercher les eleves.';
            closeResults();
          }
        }
      };

      searchInput.addEventListener('input', () => {
        select.value = '';
        searchInput.setCustomValidity('');
        renderEmpty('Selectionne un eleve pour voir son etat financier.');
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(searchStudents, 400);
      });

      searchInput.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' && !searchResults.hidden) {
          event.preventDefault();
          setActiveResult(activeIndex + 1);
        } else if (event.key === 'ArrowUp' && !searchResults.hidden) {
          event.preventDefault();
          setActiveResult(activeIndex <= 0 ? currentItems.length - 1 : activeIndex - 1);
        } else if (event.key === 'Enter' && activeIndex >= 0 && currentItems[activeIndex]) {
          event.preventDefault();
          chooseStudent(currentItems[activeIndex]);
        } else if (event.key === 'Escape') {
          closeResults();
        }
      });

      searchInput.addEventListener('blur', () => setTimeout(closeResults, 150));

      const classInfo = document.getElementById('studentClassInfo');
      const levelDisplay = document.getElementById('levelDisplay');
      const levelSelect = document.querySelector('select[name="levelId"][required]');

      // The student's class is known (declared at creation, or their last
      // enrollment's) - show it as a fact, do not make the user pick it
      // again. levelSelect still carries the real value (a disabled field
      // would not submit at all), it is only visually swapped out.
      const lockLevel = (levelId, label) => {
        if (!levelDisplay || !levelSelect || !levelId) return false;
        if (!levelSelect.querySelector('option[value="' + levelId + '"]')) {
          const option = document.createElement('option');
          option.value = levelId;
          option.textContent = label;
          levelSelect.appendChild(option);
        }
        levelSelect.value = levelId;
        levelSelect.dispatchEvent(new Event('change'));
        levelSelect.hidden = true;
        levelDisplay.value = label;
        levelDisplay.hidden = false;
        return true;
      };
      const unlockLevel = () => {
        if (!levelDisplay || !levelSelect) return;
        levelSelect.hidden = false;
        levelSelect.value = '';
        levelSelect.dispatchEvent(new Event('change'));
        levelDisplay.hidden = true;
        levelDisplay.value = '';
      };

      const renderClassInfo = (info) => {
        if (!classInfo) return;
        classInfo.replaceChildren();
        const parts = [];
        if (info && info.declared) parts.push(['Classe de l eleve : ', info.declared]);
        if (info && info.last) {
          parts.push([
            'Derniere inscription : ',
            info.last.label + (info.last.schoolYear ? ' (' + info.last.schoolYear + ')' : ''),
          ]);
        }
        parts.forEach(([label, value], index) => {
          if (index) classInfo.append(' - ');
          classInfo.append(label);
          const strong = document.createElement('strong');
          strong.textContent = value;
          classInfo.append(strong);
        });
        classInfo.hidden = parts.length === 0;

        const locked =
          (info && info.declaredId && lockLevel(info.declaredId, info.declared)) ||
          (info && info.last && info.last.levelId && lockLevel(info.last.levelId, info.last.label));
        if (!locked) unlockLevel();
      };

      // --- "Already enrolled this year" mode ---------------------------
      // The same form doubles as "record another payment" for a student who
      // already has an active enrollment for the selected year (installments,
      // a top-up, ...). Without this, submitting it for such a student would
      // reach createEnrollment()'s duplicate guard and fail with a "Double
      // inscription" error that has nothing to do with what was intended.
      // See EnrollmentsController.create() for the matching server-side
      // branch - level/type below stay populated (with the existing
      // enrollment's own values) purely so CreateEnrollmentDto still
      // validates; that branch ignores them entirely.
      const formTitle = document.getElementById('enrollFormTitle');
      const notice = document.getElementById('alreadyEnrolledNotice');
      const levelField = document.getElementById('levelField');
      const typeField = document.getElementById('typeField');
      const discountField = document.getElementById('discountField');
      const paymentSectionTitle = document.getElementById('paymentSectionTitle');
      const typeSelect = document.querySelector('select[name="type"]');
      const paymentAmountInput = document.getElementById('paymentAmount');
      const submitButton = document.getElementById('enrollSubmit');
      let payOnly = false;

      const updateSubmitLabel = () => {
        if (!submitButton) return;
        if (payOnly) {
          submitButton.textContent = 'Enregistrer le paiement';
        } else if (Number(paymentAmountInput?.value || 0) > 0) {
          submitButton.textContent = "Creer l'inscription et enregistrer le paiement";
        } else {
          submitButton.textContent = "Creer l'inscription";
        }
      };
      paymentAmountInput?.addEventListener('input', updateSubmitLabel);

      const enterPayOnlyMode = (currentEnrollment) => {
        payOnly = true;
        const levelId = currentEnrollment.levelId?._id;
        const levelLabel = currentEnrollment.levelSnapshot?.label || currentEnrollment.levelId?.label;
        if (levelId && levelLabel) lockLevel(levelId, levelLabel);
        if (typeSelect && currentEnrollment.type) typeSelect.value = currentEnrollment.type;

        if (levelField) levelField.hidden = false; // keep the read-only display visible
        if (typeField) typeField.hidden = true;
        if (discountField) discountField.hidden = true;
        if (formTitle) formTitle.textContent = 'Enregistrer un paiement';
        if (paymentSectionTitle) paymentSectionTitle.innerHTML = 'Paiement';
        if (paymentAmountInput) {
          paymentAmountInput.required = true;
          paymentAmountInput.min = '1';
        }
        if (notice) {
          notice.hidden = false;
          notice.textContent =
            'Cet eleve est deja inscrit cette annee' +
            (levelLabel ? ' en ' + levelLabel : '') +
            '. Ce paiement sera ajoute a sa facture existante.';
        }
        updateSubmitLabel();
      };

      const exitPayOnlyMode = () => {
        if (!payOnly) {
          updateSubmitLabel();
          return;
        }
        payOnly = false;
        if (typeField) typeField.hidden = false;
        if (discountField) discountField.hidden = false;
        if (formTitle) formTitle.textContent = 'Creer une inscription';
        if (paymentSectionTitle) paymentSectionTitle.innerHTML = "Paiement a l'inscription <span class=\"muted\">(optionnel)</span>";
        if (paymentAmountInput) {
          paymentAmountInput.required = false;
          paymentAmountInput.min = '0';
        }
        if (notice) notice.hidden = true;
        updateSubmitLabel();
      };

      const renderEmpty = (message) => {
        if (classInfo) classInfo.hidden = true;
        unlockLevel();
        exitPayOnlyMode();
        badge.textContent = 'En attente';
        badge.className = 'badge badge-neutral';
        container.className = 'status-empty stack';
        container.innerHTML = `<p class="muted">${message}</p>`;
      };

      const renderStatus = (payload) => {
        const currentEnrollment = payload.currentEnrollment || {};
        const currentInvoice = payload.currentInvoice || {};
        const totalDue = Number(payload.totalDue ?? 0);
        const openArrearsAmount = Number(payload.openArrearsAmount ?? 0);
        const outstandingInvoicesAmount = Number(payload.outstandingInvoicesAmount ?? 0);
        const settlementLabel = payload.isSettled ? 'Soldé' : 'A régler';
        const settlementClass = payload.isSettled ? 'badge' : 'badge badge-danger';
        const invoiceProgress = currentInvoice.totalDue
          ? Math.min(Math.round(((Number(currentInvoice.paidAmount ?? 0) / Number(currentInvoice.totalDue)) * 100)), 100)
          : 0;

        badge.textContent = settlementLabel;
        badge.className = settlementClass;

        container.className = 'status-summary';
        container.innerHTML = `
          <div class="status-hero ${payload.isSettled ? 'is-settled' : 'needs-payment'}">
            <div>
              <p class="eyebrow">Etat financier</p>
              <h3>${settlementLabel}</h3>
              <p class="muted">${payload.isSettled ? 'Aucun solde à régulariser.' : 'Le dossier comporte encore des montants à solder.'}</p>
            </div>
            <div class="status-amount">
              <span>Total à solder</span>
              <strong>${totalDue}</strong>
            </div>
          </div>

          <div class="status-metrics">
            <article class="status-metric">
              <span>Dernière inscription</span>
              <strong>${currentEnrollment.schoolYearId?.label || '-'}</strong>
            </article>
            <article class="status-metric">
              <span>Niveau actuel</span>
              <strong>${currentEnrollment.levelId?.label || '-'}</strong>
            </article>
            <article class="status-metric">
              <span>Facture en cours</span>
              <strong>${currentInvoice.status || '-'}</strong>
            </article>
            <article class="status-metric">
              <span>Reste facture</span>
              <strong>${Number(currentInvoice.balanceDue ?? 0)}</strong>
            </article>
          </div>

          <div class="status-breakdown">
            <div>
              <span>Impayes reportes</span>
              <strong>${openArrearsAmount}</strong>
            </div>
            <div>
              <span>Factures restantes</span>
              <strong>${outstandingInvoicesAmount}</strong>
            </div>
            <div>
              <span>Dossiers ouverts</span>
              <strong>${payload.openArrearsCount ?? 0}</strong>
            </div>
          </div>

          <div class="status-progress">
            <div class="status-progress-head">
              <span>Avancement du règlement de la facture actuelle</span>
              <strong>${invoiceProgress}%</strong>
            </div>
            <div class="progress-bar"><span style="width:${invoiceProgress}%"></span></div>
          </div>
        `;

        if (payload.currentEnrollment && payload.currentEnrollment.status === 'active') {
          enterPayOnlyMode(payload.currentEnrollment);
        } else {
          exitPayOnlyMode();
        }
      };

      const loadStatus = async () => {
        const studentId = select.value;
        if (!studentId) {
          renderEmpty('Selectionne un eleve pour voir son etat financier.');
          return;
        }

        renderEmpty('Chargement de la situation...');

        try {
          const response = await fetch(`/students/${studentId}/financial-status`, {
            headers: { 'Accept': 'application/json' },
          });

          if (!response.ok) {
            throw new Error('Impossible de charger la situation');
          }

          const payload = await response.json();
          // Order matters: renderClassInfo() may lock the level to the
          // student's declared/last class, but renderStatus() runs last and
          // re-locks it to their actual current-year enrollment when one
          // exists - that one must win.
          renderClassInfo(payload.studentClass);
          renderStatus(payload);
        } catch (error) {
          renderEmpty('Situation indisponible pour cet eleve.');
        }
      };

      select.addEventListener('change', loadStatus);

      const preselectedStudent = {{ preselectedStudent | dump | safe }};
      if (preselectedStudent) {
        select.value = preselectedStudent.id;
        searchInput.value = preselectedStudent.label;
      }
      loadStatus();

      // Submitting: always requires a picked student. In pay-only mode it
      // also requires a confirmation, exactly like the standalone payment
      // form on the enrollment detail page - the normal create(+pay) path
      // stays a single click, on purpose (see the enroll-quickly work this
      // followed).
      const confirmDialog = document.getElementById('enrollPaymentConfirmDialog');
      let paymentConfirmed = false;
      form.addEventListener('submit', (event) => {
        if (!select.value) {
          event.preventDefault();
          searchInput.setCustomValidity('Selectionnez un eleve dans les resultats.');
          searchInput.reportValidity();
          return;
        }
        if (!payOnly || paymentConfirmed || !confirmDialog || typeof confirmDialog.showModal !== 'function') {
          paymentConfirmed = false;
          return;
        }
        event.preventDefault();
        if (typeof form.reportValidity === 'function' && !form.reportValidity()) return;
        confirmDialog.querySelector('.js-confirm-amount').textContent = paymentAmountInput.value;
        const methodSelect = document.getElementById('paymentMethodSelect');
        confirmDialog.querySelector('.js-confirm-method').textContent =
          methodSelect?.options[methodSelect.selectedIndex]?.text || '';
        confirmDialog.showModal();
      });
      confirmDialog?.querySelector('.js-confirm-cancel')?.addEventListener('click', () => confirmDialog.close());
      confirmDialog?.querySelector('.js-confirm-ok')?.addEventListener('click', () => {
        paymentConfirmed = true;
        confirmDialog.close();
        form.requestSubmit();
      });
    })();

    // Fee hint for the payment-at-enrollment block.
    (() => {
      const feesByLevel = {{ (feesByLevel or {}) | dump | safe }};
      const level = document.querySelector('select[name="levelId"][required]');
      const discount = document.querySelector('input[name="discountAmount"]');
      const hint = document.getElementById('feeHint');
      if (!level || !hint) return;

      const refresh = () => {
        const fee = feesByLevel[level.value];
        if (!fee) {
          hint.textContent = level.value
            ? 'Aucun frais defini pour ce niveau.'
            : "Choisissez un niveau pour voir le montant de l'inscription.";
          return;
        }
        const total = Math.max(fee.registrationFee + fee.tuitionFee - Number(discount?.value || 0), 0);
        hint.textContent =
          "Inscription : " + fee.registrationFee + " - Ecolage : " + fee.tuitionFee +
          " - Total a payer : " + total + " (hors impayes reportes)";
      };
      level.addEventListener('change', refresh);
      discount?.addEventListener('input', refresh);
      refresh();
    })();
  </script>
{% endblock %}
