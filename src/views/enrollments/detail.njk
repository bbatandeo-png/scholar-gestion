{% extends "layout.njk" %}
{% import "partials/legend.njk" as legend %}
{% block content %}
  <section class="grid cols-2">
    <div class="panel">
      <div class="panel-heading">
        <div>
          <h2>Inscription</h2>
          <p class="muted">Modifiez les informations de base de l'inscription.</p>
        </div>
      </div>
      <p><strong>Élève:</strong> {{ enrollment.studentId.lastname if enrollment.studentId }} {{ enrollment.studentId.firstname if enrollment.studentId }}</p>
      <p><strong>Année:</strong> {{ enrollment.schoolYearId.label if enrollment.schoolYearId }}</p>
      <p><strong>Niveau:</strong> {{ enrollment.levelId.label if enrollment.levelId }}</p>
      <p><strong>Type:</strong> {{ ENUM_META.enrollmentType[enrollment.type].label if ENUM_META.enrollmentType[enrollment.type] else enrollment.type }}</p>
      <p><strong>Statut:</strong> {% set value = enrollment.status %}{% set group = 'enrollmentStatus' %}{% include "partials/status-badge.njk" %}</p>

      <form id="modifier" method="post" action="/enrollments/{{ enrollment._id }}?_method=PUT" class="stack">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <div class="form-grid">
          <label>Élève
            <select name="studentId" required>
              {% for student in students %}
                <option value="{{ student._id }}" {% if enrollment.studentId and enrollment.studentId._id and student._id and enrollment.studentId._id.toString() == student._id.toString() %}selected{% endif %}>{{ student.matricule }} - {{ student.lastname }} {{ student.firstname }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Année
            <select name="schoolYearId" required>
              {% for year in schoolYears %}
                <option value="{{ year._id }}" {% if enrollment.schoolYearId and enrollment.schoolYearId._id and year._id and enrollment.schoolYearId._id.toString() == year._id.toString() %}selected{% endif %}>{{ year.label }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Niveau
            <select name="levelId" required>
              <option value="" selected>Choisir un niveau (actuel : {{ enrollment.levelId.label if enrollment.levelId }})</option>
              {% for level in levels %}
                <option value="{{ level._id }}">{{ level.label }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Type
            <select name="type" required>
              {% for key, meta in ENUM_META.enrollmentType %}
                <option value="{{ key }}" {% if enrollment.type == key %}selected{% endif %} title="{{ meta.description }}">{{ meta.label }}</option>
              {% endfor %}
            </select>
          </label>
        </div>
        {# Changement de classe : voir EnrollmentsService.updateEnrollment. #}
        {% if invoice and invoice.paidAmount > 0 %}
          <div class="notice notice-warning">
            Cet élève a déjà payé <strong>{{ invoice.paidAmount | money }}</strong> cette année.
            Un changement de classe est réservé à la <strong>direction</strong> et demande un motif.
            La facture sera recalculée avec les frais de la nouvelle classe ; les paiements déjà faits sont conservés.
          </div>
          <label>Motif du changement de classe <span class="muted">(obligatoire si vous changez le niveau)</span>
            <textarea name="levelChangeReason" rows="2" placeholder="Ex : erreur de classe à l'inscription"></textarea>
          </label>
        {% else %}
          <p class="field-hint">Changer le niveau recalcule la facture avec les frais de la nouvelle classe.</p>
        {% endif %}
        <div><button type="submit" class="button">Enregistrer les changements</button></div>
      </form>
      {{ legend.render(['enrollmentType', 'enrollmentStatus']) }}
    </div>

    <div class="panel">
      <div class="panel-heading">
        <div>
          <h2>Facture</h2>
          <p class="muted">Gestion financière de l'inscription.</p>
        </div>
      </div>
      {% if invoice %}
        <p><strong>Frais d inscription:</strong> {{ invoice.registrationFee | money }}</p>
        <p><strong>Écolage:</strong> {{ invoice.tuitionFee | money }}</p>
        <p><strong>Remise:</strong> {{ invoice.discountAmount }}</p>
        <p><strong>Impayés reportés:</strong> {{ invoice.arrearsAmount | money }}</p>
        <p><strong>Total du:</strong> {{ invoice.totalDue | money }}</p>
        <p><strong>Payé:</strong> {{ invoice.paidAmount | money }}</p>
        <p><strong>Reste:</strong> {{ invoice.balanceDue | money }}</p>
        <p><strong>Statut:</strong> {% set value = invoice.status %}{% set group = 'invoiceStatus' %}{% include "partials/status-badge.njk" %}</p>

        {% if currentUser and currentUser.role == 'super_admin' %}
          <div class="stack">
            <h3>Historique des modifications</h3>
            {% if auditLogs and auditLogs.length %}
              <ul class="audit-history">
                {% for log in auditLogs %}
                  <li>
                    <strong>{{ log.actionLabel }}</strong><br>
                    <small>
                      Effectué par : {{ log.actorName }}
                      le {{ log.createdAt | formatDate }}
                    </small>
                    {% if log.detailsSummary and log.detailsSummary.length %}
                      <ul class="stack" style="margin-top: 0.35rem; padding-left: 1rem;">
                        {% for item in log.detailsSummary %}
                          <li>{{ item }}</li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p>Aucune modification enregistrée.</p>
            {% endif %}
          </div>
        {% endif %}

        <div class="stack">
          <h3>Paiement</h3>
          <form method="post" action="/payments" class="stack" id="paymentForm">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="invoiceId" value="{{ invoice._id }}" />
            <div class="form-grid">
              <label>Montant<input type="number" name="amount" min="1" {% if invoice.balanceDue > 0 %}max="{{ invoice.balanceDue }}" title="Au plus {{ invoice.balanceDue | money }} (reste à payer)"{% endif %} required /></label>
              <label>Mode
                <select name="method">
                  {% for key, meta in ENUM_META.paymentMethod %}
                    <option value="{{ key }}">{{ meta.label }}</option>
                  {% endfor %}
                </select>
              </label>
              <label>Référence<input name="reference" /></label>
            </div>
            <button type="submit">Enregistrer le paiement</button>
          </form>

          {% set dialogId = 'paymentConfirmDialog' %}
          {% include "partials/payment-confirm-dialog.njk" %}
          <script>
            confirmBeforePaymentSubmit(
              document.getElementById('paymentForm'),
              document.getElementById('paymentConfirmDialog'),
            );
          </script>
        </div>
        {{ legend.render(['invoiceStatus']) }}

        {% if activeModules.finance and currentUser and (currentUser.role == 'super_admin' or currentUser.role == 'comptabilite') %}
          <div class="stack">
            <h3>Modification financière</h3>
            <p class="muted">Cette action est réservée au Super Administrateur ou au Comptable. Le motif est obligatoire.</p>
            <form method="post" action="/enrollments/{{ enrollment._id }}/financial-details" class="stack">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <div class="form-grid">
                <label>Frais d inscription
                  <input type="number" name="registrationFee" value="{{ invoice.registrationFee }}" min="0" step="0.01" required />
                </label>
                <label>Remise appliquee
                  <input type="number" name="discountAmount" value="{{ invoice.discountAmount }}" min="0" step="0.01" required />
                </label>
                <label>Montant payé
                  <input type="number" name="paidAmount" value="{{ invoice.paidAmount }}" min="0" step="0.01" required />
                </label>
              </div>
              <label>Motif de modification
                <textarea name="reason" rows="3" required></textarea>
              </label>
              <button type="submit">Enregistrer la modification financière</button>
            </form>
          </div>
        {% endif %}
      {% else %}
        <p>Aucune facture disponible.</p>
      {% endif %}
    </div>
  </section>
{% endblock %}