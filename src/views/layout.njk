{#
  Icones de navigation : un seul jeu SVG (traits de 2px, style Lucide - licence ISC)
  au lieu de caracteres Unicode, pour une lecture homogene et sans emoji.
  Toujours decoratives ici (le libelle texte est a cote) : masquees aux lecteurs d'ecran.
#}
{% macro icon(name) %}<svg class="icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {%- if name == 'dashboard' -%}<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>
  {%- elif name == 'external' -%}<path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
  {%- elif name == 'key' -%}<circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/>
  {%- elif name == 'students' -%}<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
  {%- elif name == 'pedagogy' -%}<path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/><path d="M22 10v6"/>
  {%- elif name == 'teachers' -%}<rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
  {%- elif name == 'enrollments' -%}<rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>
  {%- elif name == 'finance' -%}<path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
  {%- elif name == 'organisation' -%}<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
  {%- elif name == 'settings' -%}<path d="M21 4h-7"/><path d="M10 4H3"/><path d="M21 12h-9"/><path d="M8 12H3"/><path d="M21 20h-5"/><path d="M12 20H3"/><path d="M14 2v4"/><path d="M8 10v4"/><path d="M16 18v4"/>
  {%- elif name == 'admin' -%}<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
  {%- elif name == 'platform' -%}<rect width="16" height="20" x="4" y="2" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M12 6h.01"/><path d="M16 6h.01"/><path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/>
  {%- elif name == 'reports' -%}<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>
  {%- elif name == 'menu' -%}<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>
  {%- elif name == 'logout' -%}<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>
  {%- elif name == 'close' -%}<path d="M18 6 6 18"/><path d="m6 6 12 12"/>
  {%- endif -%}
</svg>{% endmacro %}
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#123833" />
    <title>{{ title or 'Scolar-Gestion' }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
    <script>
      // Montants : meme rendu que le filtre nunjucks "money" (voir
      // src/common/view-helpers/format-money.ts) -> "125 000 FCFA".
      window.formatAmount = (value) => {
        if (value === null || value === undefined || value === '') return '';
        const number = Number(value);
        if (!Number.isFinite(number)) return '';
        const rounded = Math.round(number * 100) / 100;
        const [integerPart, decimals] = Math.abs(rounded).toFixed(2).split('.');
        const grouped = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, '\u202f');
        const sign = rounded < 0 ? '-' : '';
        return decimals === '00' ? sign + grouped : sign + grouped + ',' + decimals;
      };
      window.formatMoney = (value) => {
        const amount = window.formatAmount(value);
        return amount === '' ? '' : amount + '\u00a0FCFA';
      };
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Aller au contenu principal</a>
    <div class="app-shell">
      <button
        type="button"
        class="mobile-nav-toggle"
        aria-controls="main-navigation"
        aria-expanded="false"
        aria-label="Ouvrir le menu principal"
      >
        {{ icon('menu') }}
        <span>Menu</span>
      </button>
      <div class="sidebar-backdrop" aria-hidden="true"></div>
      <aside class="sidebar" id="main-navigation">
        <div class="sidebar-brand">
          <p class="eyebrow">Complexe scolaire</p>
          <p class="sidebar-title">Scolar-Gestion</p>
          <p class="sidebar-subtitle">Gestion administrative, scolaire et financière</p>
        </div>
        <nav class="nav-links" aria-label="Navigation principale">
          {% set role = currentUser.role if currentUser else '' %}

          <div class="nav-group">
            <a href="/dashboard" class="nav-link {% if currentPath == '/dashboard' %}is-active{% endif %}">
              <span class="nav-icon">{{ icon('dashboard') }}</span>
              <span>Tableau de bord</span>
            </a>
          </div>

          {% if role == 'super_admin' or role == 'direction' or role == 'secretariat' or role == 'auditeur' %}
            <div class="nav-group">
              <details class="nav-details" {% if currentPath and (currentPath.startsWith('/students') or currentPath == '/students/search' or currentPath.startsWith('/reports/student-cards')) %}open{% endif %}>
                <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('students') }}</span><span>Gestion scolaire</span></span></summary>
                <div class="nav-submenu">
                  <a href="/students" class="{% if currentPath and currentPath.startsWith('/students') and currentPath != '/students/search' %}is-active{% endif %}">Élèves</a>
                  <a href="/students/search" class="{% if currentPath == '/students/search' %}is-active{% endif %}">Recherche ancien élève</a>
                  <a href="/reports/student-cards" class="{% if currentPath and currentPath.startsWith('/reports/student-cards') %}is-active{% endif %}">Cartes scolaires</a>
                </div>
              </details>
            </div>
            {% if activeModules.bulletins or activeModules.discipline %}
              <div class="nav-group">
                <details class="nav-details" {% if currentPath and (currentPath.startsWith('/bulletins') or currentPath.startsWith('/discipline') or currentPath.startsWith('/reports/exam-statistics') or currentPath.startsWith('/reports/grade-sheet')) %}open{% endif %}>
                  <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('pedagogy') }}</span><span>Gestion pédagogique</span></span></summary>
                  <div class="nav-submenu">
                    {% if activeModules.bulletins %}
                      {# La creation d'une session se fait depuis la page des sessions (bouton « + Nouvelle session »). #}
                      <a href="/bulletins" class="{% if currentPath == '/bulletins' or (currentPath and currentPath.startsWith('/bulletins/') and not currentPath.startsWith('/bulletins/matieres')) %}is-active{% endif %}">Sessions de bulletins</a>
                      {% if role == 'super_admin' or role == 'direction' %}<a href="/bulletins/matieres" class="{% if currentPath and currentPath.startsWith('/bulletins/matieres') %}is-active{% endif %}">Matières</a>{% endif %}
                      <a href="/reports/grade-sheet" class="{% if currentPath and currentPath.startsWith('/reports/grade-sheet') %}is-active{% endif %}">Fiche de notes vierge</a>
                      <a href="/reports/exam-statistics" class="{% if currentPath and currentPath.startsWith('/reports/exam-statistics') %}is-active{% endif %}">Statistiques de fin de période</a>
                    {% endif %}
                    {% if activeModules.discipline %}
                      <a href="/discipline" class="{% if currentPath and currentPath.startsWith('/discipline') %}is-active{% endif %}">Journal de discipline</a>
                    {% endif %}
                  </div>
                </details>
              </div>
            {% endif %}
            {% if activeModules.enseignants %}
              <div class="nav-group">
                <details class="nav-details" {% if currentPath and currentPath.startsWith('/teachers') %}open{% endif %}>
                  <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('teachers') }}</span><span>Personnel enseignant</span></span></summary>
                  <div class="nav-submenu">
                    <a href="/teachers" class="{% if currentPath and currentPath.startsWith('/teachers') and not currentPath.startsWith('/teachers/new') %}is-active{% endif %}">Dossiers</a>
                    {% if role == 'super_admin' or role == 'direction' %}<a href="/teachers/new" class="{% if currentPath and currentPath.startsWith('/teachers/new') %}is-active{% endif %}">Nouvel enseignant</a>{% endif %}
                  </div>
                </details>
              </div>
            {% endif %}
          {% endif %}

          {% if role == 'super_admin' or role == 'direction' or role == 'secretariat' or role == 'comptabilite' or role == 'auditeur' %}
            <div class="nav-group">
              <details class="nav-details" {% if currentPath and currentPath.startsWith('/enrollments') %}open{% endif %}>
                <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('enrollments') }}</span><span>Admissions &amp; paiements</span></span></summary>
                <div class="nav-submenu">
                  <a href="/enrollments" class="{% if currentPath and currentPath.startsWith('/enrollments') %}is-active{% endif %}">Inscriptions et paiements</a>
                </div>
              </details>
            </div>
          {% endif %}

          {% if role == 'super_admin' or role == 'direction' or role == 'comptabilite' or role == 'auditeur' %}
            <div class="nav-group">
              <details class="nav-details" {% if currentPath and (currentPath.startsWith('/expenses') or currentPath.startsWith('/arrears') or currentPath.startsWith('/payments/corrections') or currentPath.startsWith('/facturation')) %}open{% endif %}>
                <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('finance') }}</span><span>Finances</span></span></summary>
                <div class="nav-submenu">
                  {% if activeModules.finance %}
                    {% if role == 'super_admin' or role == 'direction' or role == 'comptabilite' %}
                      <a href="/expenses" class="{% if currentPath and currentPath.startsWith('/expenses') %}is-active{% endif %}">Dépenses</a>
                    {% endif %}
                    <a href="/arrears" class="{% if currentPath and currentPath.startsWith('/arrears') %}is-active{% endif %}">Impayés</a>
                    <a href="/payments/corrections" class="{% if currentPath and currentPath.startsWith('/payments/corrections') %}is-active{% endif %}">Historique des modifications de paiement</a>
                  {% endif %}
                  {# Facturation masquee du menu (non utilisee pour l'instant) : la page reste accessible par son adresse. #}
                </div>
              </details>
            </div>
          {% endif %}

          {% if (role == 'super_admin' or role == 'direction' or role == 'secretariat' or role == 'auditeur') and (role == 'super_admin' or role == 'direction' or role == 'auditeur' or activeModules.stock) %}
            <div class="nav-group">
              <details class="nav-details" {% if currentPath and (currentPath.startsWith('/promotions') or currentPath.startsWith('/stock')) %}open{% endif %}>
                <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('organisation') }}</span><span>Organisation</span></span></summary>
                <div class="nav-submenu">
                  {% if role == 'super_admin' or role == 'direction' or role == 'auditeur' %}
                    <a href="/promotions" class="{% if currentPath and currentPath.startsWith('/promotions') %}is-active{% endif %}">Promotions</a>
                  {% endif %}
                  {% if activeModules.stock %}
                    <a href="/stock" class="{% if currentPath and currentPath.startsWith('/stock') %}is-active{% endif %}">Stocks &amp; fournitures</a>
                  {% endif %}
                </div>
              </details>
            </div>
          {% endif %}

          {% if role == 'comptabilite' %}
            <div class="nav-group">
              <details class="nav-details" {% if currentPath and currentPath.startsWith('/reports') and not currentPath.startsWith('/reports/student-cards') %}open{% endif %}>
                <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('reports') }}</span><span>Rapports &amp; indicateurs</span></span></summary>
                <div class="nav-submenu">
                  <a href="/reports/revenue" class="{% if currentPath and currentPath.startsWith('/reports') and not currentPath.startsWith('/reports/registration-paid') %}is-active{% endif %}">Rapports</a>
                  <a href="/reports/registration-paid" class="{% if currentPath and currentPath.startsWith('/reports/registration-paid') %}is-active{% endif %}">Inscriptions payées</a>
                </div>
              </details>
            </div>
          {% elif role == 'super_admin' or role == 'direction' or role == 'auditeur' %}
            <div class="nav-group">
              <details class="nav-details" {% if currentPath and currentPath.startsWith('/reports') and not currentPath.startsWith('/reports/student-cards') and not currentPath.startsWith('/reports/grade-sheet') and not currentPath.startsWith('/reports/exam-statistics') %}open{% endif %}>
                <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('reports') }}</span><span>Rapports &amp; indicateurs</span></span></summary>
                <div class="nav-submenu">
                  <a href="/reports/registration-paid" class="{% if currentPath and currentPath.startsWith('/reports/registration-paid') %}is-active{% endif %}">Inscriptions payées</a>
                </div>
              </details>
            </div>
          {% endif %}

          {% if role == 'super_admin' or role == 'direction' %}
            <div class="nav-group">
              <details class="nav-details" {% if currentPath and (currentPath.startsWith('/settings/school-years') or currentPath.startsWith('/settings/levels') or currentPath.startsWith('/settings/fees')) %}open{% endif %}>
                <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('settings') }}</span><span>Paramètres</span></span></summary>
                <div class="nav-submenu">
                  <a href="/settings/school-years" class="{% if currentPath and currentPath.startsWith('/settings/school-years') %}is-active{% endif %}">Années scolaires</a>
                  <a href="/settings/levels" class="{% if currentPath and currentPath.startsWith('/settings/levels') %}is-active{% endif %}">Niveaux</a>
                  {% if activeModules.finance %}
                    <a href="/settings/fees" class="{% if currentPath and currentPath.startsWith('/settings/fees') %}is-active{% endif %}">Frais</a>
                  {% endif %}
                </div>
              </details>
            </div>
          {% endif %}

          {% if role == 'super_admin' %}
            <div class="nav-group">
              <details class="nav-details" {% if currentPath and currentPath.startsWith('/users') %}open{% endif %}>
                <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('admin') }}</span><span>Administration</span></span></summary>
                <div class="nav-submenu">
                  <a href="/users" class="{% if currentPath and currentPath.startsWith('/users') %}is-active{% endif %}">Utilisateurs</a>
                </div>
              </details>
            </div>
          {% endif %}

          {% if role == 'platform_admin' %}
            <div class="nav-group">
              <details class="nav-details" {% if currentPath and currentPath.startsWith('/platform/ecoles') %}open{% endif %}>
                <summary><span class="nav-summary-label"><span class="nav-icon">{{ icon('platform') }}</span><span>Plateforme</span></span></summary>
                <div class="nav-submenu">
                  <a href="/platform/ecoles" class="{% if currentPath and currentPath.startsWith('/platform/ecoles') %}is-active{% endif %}">Écoles</a>
                </div>
              </details>
            </div>
          {% endif %}

          {# Liens secondaires (hors parcours quotidien) regroupes en bas du menu. #}
          <div class="nav-secondary">
            {% if licenseEnforcementEnabled and (role == 'super_admin' or role == 'direction' or role == 'secretariat') %}
              <a href="/licence" class="nav-link {% if currentPath == '/licence' %}is-active{% endif %}">
                <span class="nav-icon">{{ icon('key') }}</span>
                <span>Licence</span>
              </a>
            {% endif %}
            <a href="/vitrine" target="_blank" rel="noopener" class="nav-link">
              <span class="nav-icon">{{ icon('external') }}</span>
              <span>Site web<span class="sr-only"> (s’ouvre dans un nouvel onglet)</span></span>
            </a>
          </div>
        </nav>
      </aside>
      <main class="content" id="main-content" tabindex="-1">
        <header class="topbar">
          <div class="topbar-heading">
            <p class="eyebrow">Application administrative et financière</p>
            <div class="topbar-title-row">
              {% if currentUser and currentPath and currentPath != '/dashboard' %}
                <button
                  type="button"
                  class="button secondary btn-sm btn-icon icon-prev"
                  onclick="if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/dashboard'; }"
                >
                  Retour
                </button>
              {% endif %}
              <h1>{{ title or 'Scolar-Gestion' }}</h1>
            </div>
          </div>
          <div class="topbar-actions">
            {% if currentUser %}
              {# Recherche d'eleve disponible depuis toutes les pages (liste des eleves filtree). #}
              {% if currentUser.role in ['super_admin', 'direction', 'secretariat', 'auditeur'] %}
                <form action="/students" method="get" class="global-search" role="search">
                  <label class="sr-only" for="global-search-input">Rechercher un élève</label>
                  {# Un seul champ (loupe integree, Entree pour lancer) : pas de bouton qui ressemblerait a une seconde recherche. #}
                  <input type="search" id="global-search-input" name="q" placeholder="Rechercher un élève (nom, matricule)…" autocomplete="off" enterkeyhint="search" />
                </form>
              {% endif %}
              {% if schoolYearContext and schoolYearContext.years %}
                <form action="/settings/school-years/select" method="post" class="inline-form">
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                  <input type="hidden" name="returnTo" value="{{ currentPath }}" />
                  <label>
                    <span class="sr-only">Année scolaire consultée</span>
                    <select name="schoolYearId" onchange="this.form.submit()">
                      {% for year in schoolYearContext.years %}
                        <option value="{{ year._id }}" {% if schoolYearContext.selected and (year._id | string) == (schoolYearContext.selected._id | string) %}selected{% endif %}>
                          {{ year.label }}{% if year.status == 'open' %} — active{% endif %}
                        </option>
                      {% endfor %}
                    </select>
                  </label>
                </form>
              {% endif %}
              {# Un seul libelle visible (le nom) : le role reste en infobulle et pour les lecteurs d'ecran. #}
              {% set roleLabel = ENUM_META.role[currentUser.role].label if ENUM_META.role[currentUser.role] else currentUser.role %}
              <span class="user-chip" title="{{ roleLabel }}">
                <span class="user-chip-name">{{ currentUser.name or roleLabel }}</span>
                <span class="sr-only"> — {{ roleLabel }}</span>
              </span>
              <form action="/logout" method="post">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                <button type="submit" class="button secondary btn-logout">{{ icon('logout') }}<span>Déconnexion</span></button>
              </form>
            {% else %}
              <a href="/login" class="button">Connexion</a>
            {% endif %}
          </div>
        </header>

        {% if flash %}
          <div class="flash {{ flash.type }}" role="{{ 'alert' if flash.type == 'error' else 'status' }}">
            <span class="flash-message">{{ flash.message }}</span>
            <button type="button" class="flash-close" aria-label="Fermer le message" onclick="this.parentElement.remove()">{{ icon('close') }}</button>
          </div>
        {% endif %}

        {% if licenseStatus and licenseStatus.state == 'blocked' %}
          <div class="notice notice-danger" role="alert">
            {% if licenseStatus.expiresAt %}
              Licence expirée depuis le <strong>{{ licenseStatus.expiresAt | formatDate }}</strong> — l'application est en lecture seule.
            {% else %}
              Aucune licence enregistrée sur cette installation — l'application est en lecture seule.
            {% endif %}
            <a href="/licence">{% if licenseStatus.expiresAt %}Renouveler la licence{% else %}Activer la licence{% endif %}</a>.
          </div>
        {% elif licenseStatus and licenseStatus.state == 'grace' %}
          <div class="notice notice-danger" role="alert">
            Licence expirée depuis le <strong>{{ licenseStatus.expiresAt | formatDate }}</strong> — passage en lecture seule le <strong>{{ licenseStatus.graceEndsAt | formatDate }}</strong> si elle n'est pas renouvelée. <a href="/licence">Renouveler la licence</a>.
          </div>
        {% elif licenseStatus and licenseStatus.showWarning %}
          <div class="notice notice-warning">
            Licence valable jusqu'au <strong>{{ licenseStatus.expiresAt | formatDate }}</strong> ({{ licenseStatus.daysRemaining }} jour(s) restant(s)). <a href="/licence">Voir les détails</a>.
          </div>
        {% endif %}

        {% if schoolYearContext and schoolYearContext.isHistorical %}
          <div class="notice notice-info">
            Consultation de l’année historique <strong>{{ schoolYearContext.selected.label }}</strong> — lecture seule.
          </div>
        {% endif %}

        {% block content %}{% endblock %}

        {% include "partials/footer.njk" %}
      </main>
    </div>
    <script>
      (() => {
        const body = document.body;
        const navToggle = document.querySelector('.mobile-nav-toggle');
        const navBackdrop = document.querySelector('.sidebar-backdrop');
        const sidebar = document.querySelector('.sidebar');
        const navLinks = document.querySelector('.nav-links');
        const navDetails = document.querySelectorAll('.nav-details');
        const isCompact = () => window.matchMedia('(max-width: 980px)').matches;
        const prefersReducedMotion = () =>
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Page courante annoncee aux lecteurs d'ecran, pas seulement coloree.
        document
          .querySelectorAll('.sidebar a.is-active')
          .forEach((link) => link.setAttribute('aria-current', 'page'));

        const setNavigationOpen = (open, { restoreFocus = false } = {}) => {
          const wasOpen = body.classList.contains('nav-open');
          body.classList.toggle('nav-open', open);
          navToggle?.setAttribute('aria-expanded', String(open));
          sidebar?.setAttribute('aria-hidden', String(!open && isCompact()));
          if (sidebar && 'inert' in sidebar) {
            sidebar.inert = !open && isCompact();
          }
          navToggle?.setAttribute(
            'aria-label',
            open ? 'Fermer le menu principal' : 'Ouvrir le menu principal',
          );
          if (open && !wasOpen) {
            // Focus sur la page courante (ou le premier lien) a l'ouverture.
            const target =
              sidebar?.querySelector('a.is-active') ||
              sidebar?.querySelector('a, summary');
            target?.focus();
          } else if (!open && wasOpen && restoreFocus) {
            navToggle?.focus();
          }
        };

        navToggle?.addEventListener('click', () => {
          setNavigationOpen(!body.classList.contains('nav-open'));
        });
        navBackdrop?.addEventListener('click', () =>
          setNavigationOpen(false, { restoreFocus: true }),
        );
        sidebar?.addEventListener('click', (event) => {
          if (event.target.closest('a') && isCompact()) {
            setNavigationOpen(false);
          }
        });
        navDetails.forEach((details) => {
          const summary = details.querySelector('summary');
          summary?.setAttribute('aria-expanded', String(details.open));

          details.addEventListener('toggle', () => {
            summary?.setAttribute('aria-expanded', String(details.open));
            if (!details.open || !navLinks) {
              return;
            }

            requestAnimationFrame(() => {
              const navigationRect = navLinks.getBoundingClientRect();
              const detailsRect = details.getBoundingClientRect();
              const behavior = prefersReducedMotion() ? 'auto' : 'smooth';

              if (detailsRect.bottom > navigationRect.bottom) {
                navLinks.scrollBy({
                  top: detailsRect.bottom - navigationRect.bottom + 12,
                  behavior,
                });
              } else if (detailsRect.top < navigationRect.top) {
                navLinks.scrollBy({
                  top: detailsRect.top - navigationRect.top - 12,
                  behavior,
                });
              }
            });
          });
        });

        // Garde le lien actif visible dans un menu long (desktop).
        const activeLink = sidebar?.querySelector('a.is-active');
        if (activeLink && navLinks && !isCompact()) {
          const linkRect = activeLink.getBoundingClientRect();
          const navRect = navLinks.getBoundingClientRect();
          if (linkRect.bottom > navRect.bottom || linkRect.top < navRect.top) {
            // Defile uniquement la liste des liens (pas scrollIntoView, qui
            // ferait aussi defiler la barre laterale et masquerait son titre).
            navLinks.scrollTop +=
              linkRect.top - navRect.top - (navRect.height - linkRect.height) / 2;
          }
        }

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && body.classList.contains('nav-open')) {
            setNavigationOpen(false, { restoreFocus: true });
          }
        });
        window.addEventListener('resize', () => {
          if (!isCompact()) {
            setNavigationOpen(false);
            sidebar?.removeAttribute('aria-hidden');
            if (sidebar) {
              sidebar.inert = false;
            }
          }
        });
        if (isCompact()) {
          sidebar?.setAttribute('aria-hidden', 'true');
          if (sidebar && 'inert' in sidebar) {
            sidebar.inert = true;
          }
        }

        // Reutilisable : live-search.js le rappelle sur les resultats qu'il
        // vient d'inserer (window.enhanceTables), sans re-traiter les autres.
        const enhanceTables = (root = document) => {
        root.querySelectorAll('table').forEach((table) => {
          if (!table.parentElement?.classList.contains('table-shell')) {
            const shell = document.createElement('div');
            shell.className = 'table-shell';
            table.parentNode.insertBefore(shell, table);
            shell.appendChild(table);
          }
        });

        const tables = root.querySelectorAll('table.js-sortable');

        tables.forEach((table) => {
          const body = table.querySelector('tbody');
          const headers = Array.from(table.querySelectorAll('th.sortable'));

          if (!body || headers.length === 0 || table.dataset.sortReady) {
            return;
          }
          table.dataset.sortReady = 'true';

          const sortBy = (header) => {
            const index = Number(header.dataset.columnIndex || '-1');
            const type = header.dataset.sortType || 'text';

            if (index < 0) {
              return;
            }

            const rows = Array.from(body.querySelectorAll('tr'));
            const current = header.dataset.sortDirection === 'asc' ? 'asc' : 'desc';
            const next = current === 'asc' ? 'desc' : 'asc';

            headers.forEach((th) => {
              th.classList.remove('sort-asc', 'sort-desc');
              th.dataset.sortDirection = '';
              th.setAttribute('aria-sort', 'none');
            });

            rows.sort((a, b) => {
              const aText = (a.children[index]?.textContent || '').trim();
              const bText = (b.children[index]?.textContent || '').trim();

              if (type === 'number') {
                const aNum = Number(aText.replace(/[^0-9.-]/g, '')) || 0;
                const bNum = Number(bText.replace(/[^0-9.-]/g, '')) || 0;
                return next === 'asc' ? aNum - bNum : bNum - aNum;
              }

              return next === 'asc'
                ? aText.localeCompare(bText, 'fr', { sensitivity: 'base' })
                : bText.localeCompare(aText, 'fr', { sensitivity: 'base' });
            });

            rows.forEach((row) => body.appendChild(row));
            header.dataset.sortDirection = next;
            header.classList.add(next === 'asc' ? 'sort-asc' : 'sort-desc');
            header.setAttribute('aria-sort', next === 'asc' ? 'ascending' : 'descending');
          };

          // Tri utilisable au clavier (Entree / Espace), etat annonce via aria-sort.
          headers.forEach((header) => {
            header.tabIndex = 0;
            header.setAttribute('aria-sort', 'none');
            header.addEventListener('click', () => sortBy(header));
            header.addEventListener('keydown', (event) => {
              if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                sortBy(header);
              }
            });
          });
        });
        };
        window.enhanceTables = enhanceTables;
        enhanceTables();

        // Une seule recherche par page : la recherche d'eleve de l'en-tete
        // s'efface quand la page a deja la sienne (barre de filtres, recherche
        // instantanee ou filtre de liste).
        // Verifie une fois la page prete : le filtre de liste (table-filter.js,
        // charge en differe) n'existe pas encore a ce stade.
        document.addEventListener('DOMContentLoaded', () => {
          const globalSearch = document.querySelector('.global-search');
          const pageHasSearch = document.querySelector(
            'main form[role="search"]:not(.global-search), main .table-filter, main [data-table-filter]',
          );
          if (globalSearch && pageHasSearch) {
            globalSearch.hidden = true;
          }
        });

        // Fenetres d'ajout / modification : <button data-open-dialog="id">
        // ouvre la <dialog id="id">, [data-close-dialog] la referme. Commun
        // a toutes les pages (une page peut avoir son propre script : la
        // garde !dialog.open evite une double ouverture).
        document.addEventListener('click', (event) => {
          const opener = event.target.closest('[data-open-dialog]');
          if (opener) {
            const dialog = document.getElementById(opener.dataset.openDialog);
            if (dialog && typeof dialog.showModal === 'function' && !dialog.open) {
              dialog.showModal();
              dialog
                .querySelector('input:not([type="hidden"]), select, textarea')
                ?.focus();
            }
          }
          const closer = event.target.closest('dialog [data-close-dialog]');
          if (closer) {
            event.preventDefault();
            closer.closest('dialog').close();
          }
        });
      })();
    </script>
    <script>
      (() => {
        // Prevents an impatient double-click on "Importer" (or any other
        // file-upload submit) from firing the request twice while the
        // upload is in flight - does not block the submission itself, only
        // disables the button and swaps its label once it has started.
        document.querySelectorAll('form[enctype="multipart/form-data"]').forEach((form) => {
          form.addEventListener('submit', () => {
            const submitControl = form.querySelector(
              'button[type="submit"], button:not([type]), input[type="submit"]',
            );
            if (!submitControl || submitControl.disabled) {
              return;
            }
            submitControl.disabled = true;
            submitControl.setAttribute('aria-busy', 'true');
            if (submitControl.tagName === 'INPUT') {
              submitControl.value = 'Import en cours…';
            } else {
              submitControl.textContent = 'Import en cours…';
            }
          });
        });
      })();
    </script>
    <script src="/table-filter.js" defer></script>
    <script src="/live-search.js" defer></script>
  </body>
</html>
