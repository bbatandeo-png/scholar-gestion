{% extends "layout.njk" %}
{% import "partials/legend.njk" as legend %}
{% block content %}
  <section class="panel">
    <div class="panel-heading">
      <p class="muted">Avertissements, sanctions et convocations sur toute la scolarité de l'élève, toutes années confondues.</p>
      <div class="panel-heading-actions">
        <a class="button secondary" id="disciplinePdfLink" href="/discipline/pdf?studentId={{ filters.studentId }}&amp;levelId={{ filters.levelId }}&amp;schoolYearId={{ filters.schoolYearId }}&amp;type={{ filters.type }}" download>Télécharger en PDF</a>
        {% if currentUser and currentUser.role in ['super_admin', 'direction'] %}<a class="button" href="/discipline/new{{ '?studentId=' + filters.studentId if filters.studentId }}">+ Ajouter une entrée</a>{% endif %}
      </div>
    </div>

    {% if student %}
      <div class="notice">
        Filtre sur <strong>{{ student.matricule }} - {{ student.lastname }} {{ student.firstname }}</strong>.
        <a href="/discipline">Voir tout le journal</a>
      </div>
    {% endif %}

    <form method="get" action="/discipline" class="filter-bar" role="search" data-live-search="#discipline-results">
      <input type="hidden" name="studentId" value="{{ filters.studentId }}" />
      <label class="filter-bar-search">Rechercher
        <input type="search" data-table-filter="#disciplineTable" placeholder="Élève, matricule, motif…" autocomplete="off" aria-label="Rechercher dans le journal affiché" />
      </label>
      <label>Classe
        <select name="levelId">
          <option value="">Toutes les classes</option>
          {% for level in levels %}
            <option value="{{ level._id }}" {% if filters.levelId == level._id.toString() %}selected{% endif %}>{{ level.label }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Année scolaire
        <select name="schoolYearId">
          <option value="">Toutes les années</option>
          {% for year in schoolYears %}
            <option value="{{ year._id }}" {% if filters.schoolYearId == year._id.toString() %}selected{% endif %}>{{ year.label }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Type
        <select name="type">
          <option value="">Tous les types</option>
          {% for key, meta in ENUM_META.disciplineRecordType %}
            <option value="{{ key }}" {% if filters.type == key %}selected{% endif %}>{{ meta.label }}</option>
          {% endfor %}
        </select>
      </label>
      <button type="submit" class="button">Filtrer</button>
    </form>

    <div id="discipline-results">
    <div class="table-shell">
      <table class="table-report" id="disciplineTable" data-no-filter>
        <thead>
          <tr>
            <th>N°</th>
            <th>Date</th>
            <th>Élève</th>
            <th>Matricule</th>
            <th>Année</th>
            <th>Type</th>
            <th>Motif</th>
            <th>Mesure</th>
            <th>Enregistré par</th>
          </tr>
        </thead>
        <tbody>
          {% for record in items %}
            <tr>
              <td>{{ (page - 1) * pageSize + loop.index }}</td>
              <td>{{ record.date | formatDate }}</td>
              <td><a href="/students/{{ record.studentId._id }}">{{ record.studentId.lastname }} {{ record.studentId.firstname }}</a></td>
              <td>{{ record.studentId.matricule }}</td>
              <td>{{ record.schoolYearId.label if record.schoolYearId }}</td>
              <td>{% set value = record.type %}{% set group = 'disciplineRecordType' %}{% include "partials/status-badge.njk" %}</td>
              <td>{{ record.motif }}</td>
              <td>{{ record.mesure or '—' }}</td>
              <td>{{ record.recordedBy.name if record.recordedBy else '—' }}</td>
            </tr>
          {% else %}
            <tr><td colspan="9">Aucune entrée au journal de discipline.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if items.length %}
      <div class="pagination-row">
        <form method="get" action="/discipline" class="inline-form">
          <input type="hidden" name="studentId" value="{{ filters.studentId }}" />
          <input type="hidden" name="levelId" value="{{ filters.levelId }}" />
          <input type="hidden" name="schoolYearId" value="{{ filters.schoolYearId }}" />
          <input type="hidden" name="type" value="{{ filters.type }}" />
          <input type="hidden" name="page" value="{{ page - 1 }}" />
          <button type="submit" class="secondary btn-sm btn-icon icon-prev" {% if page <= 1 %}disabled{% endif %}>Précédent</button>
        </form>
        <span class="muted">Page {{ page }} sur {{ totalPages }} • {{ total }} entrée(s)</span>
        <form method="get" action="/discipline" class="inline-form">
          <input type="hidden" name="studentId" value="{{ filters.studentId }}" />
          <input type="hidden" name="levelId" value="{{ filters.levelId }}" />
          <input type="hidden" name="schoolYearId" value="{{ filters.schoolYearId }}" />
          <input type="hidden" name="type" value="{{ filters.type }}" />
          <input type="hidden" name="page" value="{{ page + 1 }}" />
          <button type="submit" class="secondary btn-sm btn-icon icon-next" {% if page >= totalPages %}disabled{% endif %}>Suivant</button>
        </form>
      </div>
    {% endif %}

    {{ legend.render(['disciplineRecordType']) }}
    </div>
  </section>
  <script>
    // Le bouton PDF reste en haut de page : quand la recherche instantanee
    // change les filtres (et l'URL), son lien suit les nouveaux filtres.
    document.addEventListener('live-search:updated', () => {
      const link = document.getElementById('disciplinePdfLink');
      if (!link) return;
      const params = new URLSearchParams(window.location.search);
      params.delete('page');
      link.href = '/discipline/pdf?' + params.toString();
    });
  </script>
{% endblock %}
