{% extends "login-layout.njk" %}

{% block content %}
<section class="panel auth-panel">
  <div class="auth-panel__header">
    <p class="eyebrow">Accès sécurisé</p>
    <p class="muted">Connectez-vous avec les identifiants fournis par votre établissement.</p>
  </div>

  {% if next %}<p class="notice notice-info" role="status">Votre session a expiré ou vous n'êtes pas connecté : connectez-vous pour continuer.</p>{% endif %}

  <form action="/login" method="post" class="stack auth-form">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    {% if next %}<input type="hidden" name="next" value="{{ next }}" />{% endif %}

    <div class="field">
      <label for="email">
        <span>Email</span>
        <input id="email" type="email" name="email" required autocomplete="username" spellcheck="false" autocapitalize="off" placeholder="exemple@ecole.local…" />
      </label>
    </div>

    <div class="field">
      <label for="password">
        <span>Mot de passe</span>
        <input id="password" type="password" name="password" required autocomplete="current-password" />
      </label>
    </div>

    <button type="submit" class="button full-width">Se connecter</button>
    <p class="muted auth-help">Mot de passe oublié ? Demandez à l'administrateur de votre établissement de le réinitialiser depuis la page Utilisateurs.</p>
  </form>
</section>
{% endblock %}
