{% extends "layout.njk" %}
{% import "partials/legend.njk" as legend %}
{% block content %}
  <section>
    <div class="panel">
      <div class="panel-heading">
        <p class="muted">Matériel pédagogique et administratif de l'établissement.</p>
        <div class="panel-heading-actions">
          <a class="button secondary btn-icon icon-export" href="/stock/export">Exporter Excel</a>
          <button type="button" class="button" data-open-dialog="stockCreateDialog">+ Ajouter un article</button>
        </div>
      </div>

      <form method="get" action="/stock" class="toolbar compact-actions" role="search" data-live-search="#stock-results">
        <label class="field-inline">
          Recherche
          <input type="search" name="q" value="{{ filters.q }}" placeholder="Nom de l'article…" autocomplete="off" />
        </label>
        <label class="field-inline">
          Catégorie
          <select name="category">
            <option value="">Toutes les catégories</option>
            {% for key, meta in ENUM_META.stockCategory %}
              <option value="{{ key }}" {% if filters.category == key %}selected{% endif %}>{{ meta.label }}</option>
            {% endfor %}
          </select>
        </label>
        <button type="submit" class="button">Filtrer</button>
        {% if filters.q or filters.category %}
          <a href="/stock" class="button secondary btn-sm">Réinitialiser</a>
        {% endif %}
      </form>

      <div id="stock-results">
      <div class="table-shell">
        <table class="table-report" data-no-filter>
          <thead>
            <tr>
              <th>N°</th>
              <th>Nom</th>
              <th>Catégorie</th>
              <th>Quantité</th>
              <th>Unité</th>
              <th>Emplacement</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for item in items %}
              <tr>
                <td>{{ loop.index }}</td>
                <td>{{ item.name }}</td>
                <td>{% set value = item.category %}{% set group = 'stockCategory' %}{% include "partials/status-badge.njk" %}</td>
                <td>
                  {{ item.quantity }}
                  {% if item.isLow %}<span class="badge badge-danger">Seuil bas</span>{% endif %}
                </td>
                <td>{{ item.unit }}</td>
                <td>{{ item.location or '—' }}</td>
                <td><a class="button secondary btn-sm" href="/stock/{{ item._id }}">Voir</a></td>
              </tr>
            {% else %}
              <tr><td colspan="7">Aucun article enregistré.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {{ legend.render(['stockCategory']) }}
      </div>
    </div>
  </section>

<dialog id="stockCreateDialog" class="confirm-dialog app-dialog" aria-labelledby="stockCreateTitle">
  <form method="post" action="/stock" class="stack">
    <h3 id="stockCreateTitle">Ajouter un article</h3>
    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
    <div class="form-grid">
      <label>Nom<input name="name" required autocomplete="off" placeholder="Ex : Craie blanche" /></label>
      <label>Catégorie
        <select name="category" required>
          {% for key, meta in ENUM_META.stockCategory %}
            <option value="{{ key }}">{{ meta.label }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Unité<input name="unit" value="unité" required /></label>
      <label>Seuil d'alerte <span class="muted">(facultatif)</span><input type="number" name="alertThreshold" min="0" /></label>
      <label>Emplacement <span class="muted">(facultatif)</span><input name="location" /></label>
    </div>
    <label>Notes <span class="muted">(facultatif)</span><textarea name="notes" rows="2"></textarea></label>
    <div class="toolbar compact-actions dialog-actions">
      <button type="button" class="button secondary" data-close-dialog>Annuler</button>
      <button type="submit" class="button btn-icon icon-save">Ajouter</button>
    </div>
  </form>
</dialog>
{% endblock %}
