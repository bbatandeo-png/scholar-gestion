{% extends "layout.njk" %}
{% block content %}
  <section class="panel">
    <div class="panel-heading">
      <div>
        <h2>Coherence des paiements</h2>
        <p class="muted">Année {{ selectedYear.label }} : compare, facture par facture, le montant payé affiché sur la facture et la somme des paiements enregistrés (celle qu'utilisent le tableau de bord et le rapport des recettes).</p>
      </div>
    </div>

    {% if rows.length %}
      <div class="notice notice-warning">
        <strong>{{ rows.length }} facture(s) en écart</strong> — le tableau de bord compte
        <strong>{{ totalDifference | money }}</strong> de {{ 'plus' if totalDifference > 0 else 'moins' }}
        que les listes imprimées. Cela arrive quand un montant payé a été corrigé à la main
        (par exemple pour annuler un paiement saisi par erreur) avant que la correction ne soit
        répercutée sur les paiements enregistrés.
      </div>

      <div class="table-shell top-gap">
        <table class="table-report">
          <thead>
            <tr>
              <th>N°</th>
              <th>Élève</th>
              <th>Matricule</th>
              <th>Niveau</th>
              <th>Payé sur la facture</th>
              <th>Somme des paiements</th>
              <th>Ecart</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for row in rows %}
              <tr>
                <td>{{ loop.index }}</td>
                <td>{{ row.studentName }}</td>
                <td>{{ row.matricule }}</td>
                <td>{{ row.levelLabel }}</td>
                <td>{{ row.invoicePaid | money }}</td>
                <td>{{ row.ledgerPaid | money }}</td>
                <td><strong>{{ row.difference }}</strong></td>
                <td>{% if row.enrollmentId %}<a class="button secondary btn-sm" href="/enrollments/{{ row.enrollmentId }}">Voir</a>{% endif %}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {% if currentUser and (currentUser.role == 'super_admin' or currentUser.role == 'comptabilite') %}
        <form method="post" action="/payments/reconciliation" class="stack top-gap">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <p class="muted">La facture fait foi : une ligne de correction est ajoutée aux paiements de chaque facture concernée (aucun paiement existant n'est supprimé ni modifié).</p>
          <button type="submit" class="btn-icon icon-save">Aligner les paiements sur les factures</button>
        </form>
      {% endif %}
    {% else %}
      <div class="notice notice-info">Aucun écart : le montant payé de chaque facture correspond à la somme des paiements enregistrés.</div>
    {% endif %}
  </section>
{% endblock %}
