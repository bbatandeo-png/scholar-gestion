{% extends "layout.njk" %}
{% import "partials/legend.njk" as legend %}
{% block content %}
  <div class="panel notice" id="new-credentials-panel" style="display:none;"
       data-has-new="{{ 'true' if newCredentials else 'false' }}"
       data-admin-email="{{ newCredentials.email if newCredentials else '' }}"
       data-admin-password="{{ newCredentials.tempPassword if newCredentials else '' }}">
    <h3>Compte administrateur créé</h3>
    <p class="muted">Notez ces identifiants - ils resteront affichés même après rechargement de la page, jusqu'à ce que vous cliquiez sur "Fermer".</p>
    <div class="form-grid">
      <label>Email
        <div class="inline-form no-wrap">
          <input type="text" id="new-admin-email" readonly />
          <button type="button" class="button secondary btn-sm" data-copy-target="new-admin-email">Copier</button>
        </div>
      </label>
      <label>Mot de passe temporaire
        <div class="inline-form no-wrap">
          <input type="text" id="new-admin-password" readonly />
          <button type="button" class="button secondary btn-sm" data-copy-target="new-admin-password">Copier</button>
        </div>
      </label>
    </div>
    <div class="toolbar compact-actions top-gap">
      <button type="button" class="button secondary btn-sm" id="dismiss-new-credentials">J'ai note les identifiants, fermer</button>
    </div>
  </div>
  <script>
    (function () {
      var STORAGE_KEY = 'schoolar_new_admin_credentials';
      var panel = document.getElementById('new-credentials-panel');

      // The server only ever reveals a freshly created password once (it
      // isn't stored in clear text) - mirror that one reveal into
      // sessionStorage so it survives a page reload/navigation within this
      // tab, instead of vanishing the instant the server-side one-time
      // value is consumed.
      if (panel.getAttribute('data-has-new') === 'true') {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
          email: panel.getAttribute('data-admin-email'),
          tempPassword: panel.getAttribute('data-admin-password'),
        }));
      }

      var stored = sessionStorage.getItem(STORAGE_KEY);
      if (stored) {
        var credentials = JSON.parse(stored);
        document.getElementById('new-admin-email').value = credentials.email;
        document.getElementById('new-admin-password').value = credentials.tempPassword;
        panel.style.display = '';
      }

      document.getElementById('dismiss-new-credentials').addEventListener('click', function () {
        sessionStorage.removeItem(STORAGE_KEY);
        panel.style.display = 'none';
      });

      function flashButton(button, text, durationMs) {
        var original = button.textContent;
        button.textContent = text;
        setTimeout(function () {
          button.textContent = original;
        }, durationMs);
      }

      // Try the old execCommand('copy') FIRST, not as a fallback: it runs
      // synchronously inside the click handler, so it reliably stays
      // within the "trusted user gesture" window. navigator.clipboard is
      // async - by the time its .then()/.catch() callback runs it can be
      // outside that window in some browsers/embedded webviews (VS Code's
      // Simple Browser included), which silently no-ops and leaves the
      // clipboard holding whatever was copied there before (e.g. the
      // current page's own URL) - exactly the confusing symptom this
      // ordering avoids.
      function legacyCopy(field) {
        field.focus();
        field.select();
        try {
          return document.execCommand('copy');
        } catch (e) {
          return false;
        }
      }

      function copyField(field, button) {
        if (legacyCopy(field)) {
          flashButton(button, 'Copie !', 1500);
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(field.value).then(
            function () {
              flashButton(button, 'Copie !', 1500);
            },
            function () {
              flashButton(button, 'Échec - sélectionnez et Ctrl+C', 3000);
            },
          );
        } else {
          flashButton(button, 'Échec - sélectionnez et Ctrl+C', 3000);
        }
      }

      document.querySelectorAll('[data-copy-target]').forEach(function (button) {
        button.addEventListener('click', function () {
          var field = document.getElementById(button.getAttribute('data-copy-target'));
          copyField(field, button);
        });
      });
    })();
  </script>

  {% if editEcole %}
    <div class="panel top-gap">
      <div class="panel-heading">
        <div>
          <h3>Comptes de cette école</h3>
          <p class="muted">Copiez l'email ou réinitialisez le mot de passe si l'école n'arrive pas à se connecter.</p>
        </div>
      </div>
      <div class="table-shell">
        <table class="table-report">
          <thead>
            <tr><th>N°</th><th>Nom</th><th>Email</th><th>Rôle</th><th>Statut</th><th></th></tr>
          </thead>
          <tbody>
            {% for admin in ecoleAdmins %}
              <tr>
                <td>{{ loop.index }}</td>
                <td>{{ admin.name }}</td>
                <td>
                  <div class="inline-form no-wrap">
                    <input type="text" id="admin-email-{{ admin._id }}" value="{{ admin.email }}" readonly />
                    <button type="button" class="button secondary btn-sm" data-copy-target="admin-email-{{ admin._id }}">Copier</button>
                  </div>
                </td>
                <td>{{ ENUM_META.role[admin.role].label if ENUM_META.role[admin.role] else admin.role }}</td>
                <td>{% set value = admin.status %}{% set group = 'userStatus' %}{% include "partials/status-badge.njk" %}</td>
                <td>
                  <form method="post" action="/platform/ecoles/{{ editEcole._id }}/users/{{ admin._id }}/reset-password" class="inline-form no-wrap" onsubmit="return confirm('Réinitialiser le mot de passe de ce compte ? Un nouveau mot de passe temporaire sera généré et devra lui être communique.');">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                    <button type="submit" class="button danger btn-sm">Réinitialiser le mot de passe</button>
                  </form>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="6">Aucun compte pour cette école.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <div class="panel top-gap">
      <div class="panel-heading">
        <div>
          <h3>Modules actives</h3>
          <p class="muted">Une écriture est refusée tant qu'un module est désactivé - les données déjà saisies restent consultables.</p>
        </div>
      </div>
      <div class="form-grid">
        <div>
          <strong>Finance</strong>
          <p class="muted">{{ 'Actif' if moduleStatus.finance else 'Inactif' }}</p>
          {% if moduleStatus.finance %}
            <form method="post" action="/platform/ecoles/{{ editEcole._id }}/modules/toggle" class="inline-form no-wrap" onsubmit="return confirm('Désactiver le module Finance pour cette école ? Toute nouvelle ecriture financière sera refusee tant que le module ne sera pas reactive (les données déjà saisies restent consultables).');">
          {% else %}
            <form method="post" action="/platform/ecoles/{{ editEcole._id }}/modules/toggle" class="inline-form no-wrap" onsubmit="return confirm('Activer le module Finance pour cette école ?');">
          {% endif %}
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="code" value="FINANCE" />
            <input type="hidden" name="active" value="{{ 'false' if moduleStatus.finance else 'true' }}" />
            <button type="submit" class="button btn-sm {{ 'danger' if moduleStatus.finance }}">{{ 'Désactiver' if moduleStatus.finance else 'Activer' }}</button>
          </form>
        </div>
        <div>
          <strong>Bulletins</strong>
          <p class="muted">{{ 'Actif' if moduleStatus.bulletins else 'Inactif' }}</p>
          {% if moduleStatus.bulletins %}
            <form method="post" action="/platform/ecoles/{{ editEcole._id }}/modules/toggle" class="inline-form no-wrap" onsubmit="return confirm('Désactiver le module Bulletins pour cette école ? Toute nouvelle ecriture sur les bulletins sera refusee tant que le module ne sera pas reactive (les données déjà saisies restent consultables).');">
          {% else %}
            <form method="post" action="/platform/ecoles/{{ editEcole._id }}/modules/toggle" class="inline-form no-wrap" onsubmit="return confirm('Activer le module Bulletins pour cette école ?');">
          {% endif %}
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="code" value="BULLETINS" />
            <input type="hidden" name="active" value="{{ 'false' if moduleStatus.bulletins else 'true' }}" />
            <button type="submit" class="button btn-sm {{ 'danger' if moduleStatus.bulletins }}">{{ 'Désactiver' if moduleStatus.bulletins else 'Activer' }}</button>
          </form>
        </div>
        <div>
          <strong>Journal de discipline</strong>
          <p class="muted">{{ 'Actif' if moduleStatus.discipline else 'Inactif' }}</p>
          {% if moduleStatus.discipline %}
            <form method="post" action="/platform/ecoles/{{ editEcole._id }}/modules/toggle" class="inline-form no-wrap" onsubmit="return confirm('Désactiver le Journal de discipline pour cette école ? Toute nouvelle ecriture sera refusee tant que le module ne sera pas reactive (les données déjà saisies restent consultables).');">
          {% else %}
            <form method="post" action="/platform/ecoles/{{ editEcole._id }}/modules/toggle" class="inline-form no-wrap" onsubmit="return confirm('Activer le Journal de discipline pour cette école ?');">
          {% endif %}
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="code" value="DISCIPLINE" />
            <input type="hidden" name="active" value="{{ 'false' if moduleStatus.discipline else 'true' }}" />
            <button type="submit" class="button btn-sm {{ 'danger' if moduleStatus.discipline }}">{{ 'Désactiver' if moduleStatus.discipline else 'Activer' }}</button>
          </form>
        </div>
        <div>
          <strong>Stocks &amp; fournitures</strong>
          <p class="muted">{{ 'Actif' if moduleStatus.stock else 'Inactif' }}</p>
          {% if moduleStatus.stock %}
            <form method="post" action="/platform/ecoles/{{ editEcole._id }}/modules/toggle" class="inline-form no-wrap" onsubmit="return confirm('Désactiver Stocks &amp; fournitures pour cette école ? Toute nouvelle ecriture sera refusee tant que le module ne sera pas reactive (les données déjà saisies restent consultables).');">
          {% else %}
            <form method="post" action="/platform/ecoles/{{ editEcole._id }}/modules/toggle" class="inline-form no-wrap" onsubmit="return confirm('Activer Stocks &amp; fournitures pour cette école ?');">
          {% endif %}
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="code" value="STOCK" />
            <input type="hidden" name="active" value="{{ 'false' if moduleStatus.stock else 'true' }}" />
            <button type="submit" class="button btn-sm {{ 'danger' if moduleStatus.stock }}">{{ 'Désactiver' if moduleStatus.stock else 'Activer' }}</button>
          </form>
        </div>
        <div>
          <strong>Personnel enseignant</strong>
          <p class="muted">{{ 'Actif' if moduleStatus.enseignants else 'Inactif' }}</p>
          {% if moduleStatus.enseignants %}
            <form method="post" action="/platform/ecoles/{{ editEcole._id }}/modules/toggle" class="inline-form no-wrap" onsubmit="return confirm('Désactiver le module Personnel enseignant pour cette école ? Toute nouvelle ecriture sera refusee tant que le module ne sera pas reactive (les données déjà saisies restent consultables).');">
          {% else %}
            <form method="post" action="/platform/ecoles/{{ editEcole._id }}/modules/toggle" class="inline-form no-wrap" onsubmit="return confirm('Activer le module Personnel enseignant pour cette école ?');">
          {% endif %}
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="code" value="ENSEIGNANTS" />
            <input type="hidden" name="active" value="{{ 'false' if moduleStatus.enseignants else 'true' }}" />
            <button type="submit" class="button btn-sm {{ 'danger' if moduleStatus.enseignants }}">{{ 'Désactiver' if moduleStatus.enseignants else 'Activer' }}</button>
          </form>
        </div>
        <div>
          <strong>Paiement à l'inscription obligatoire</strong>
          <p class="muted">{{ 'Oui' if registrationPaymentRequired else 'Non (optionnel)' }}</p>
          <form method="post" action="/platform/ecoles/{{ editEcole._id }}/registration-payment-required/toggle" class="inline-form no-wrap">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <input type="hidden" name="required" value="{{ 'false' if registrationPaymentRequired else 'true' }}" />
            <button type="submit" class="button secondary btn-sm">{{ 'Rendre optionnel' if registrationPaymentRequired else 'Rendre obligatoire' }}</button>
          </form>
        </div>
      </div>
    </div>
    <div class="panel top-gap">
      <div class="panel-heading">
        <div>
          <h3>Pack d'installation</h3>
          <p class="muted">Exe préconstruit (fabriqué via <code>npm run build:exe:native</code> et déposé sur ce serveur), empaqueté avec un <code>.env</code> généré pour cette école (secrets propres, admin de cette école). Rien n'est compile ici — c'est un simple assemblage de fichiers.</p>
        </div>
      </div>
      {% if releaseAssetsConfigured %}
        <form method="get" action="/platform/ecoles/{{ editEcole._id }}/installation-package" id="download-installation-package-form" class="inline-form no-wrap">
          <label>Date d'expiration de la licence (optionnelle)
            <input type="date" name="expiresAt" min="{{ today }}" />
          </label>
          <button type="submit" class="button" id="download-installation-package">Télécharger le pack d'installation (.zip)</button>
        </form>
        <p class="muted" style="margin:10px 0 0;">Avec une date : le pack généré est déjà actif jusqu'à cette date, sans aucune action supplémentaire côté école au premier démarrage. Sans date : le pack part sans limite de licence (comme avant), a decider plus tard.</p>
        {% if editEcole.licenseActivatedAt %}
          <p class="muted" style="margin:4px 0 0;">Dernier téléchargement : {{ editEcole.licenseActivatedAt | formatDate }}{% if editEcole.releaseVersion %} (version {{ editEcole.releaseVersion }}){% endif %}{% if editEcole.licenseExpiresAt %}, licence jusqu'au {{ editEcole.licenseExpiresAt | formatDay }}{% endif %}.</p>
        {% endif %}
        <script>
          (() => {
            const form = document.getElementById('download-installation-package-form');
            // A download never navigates the page, so "Dernier
            // telechargement" (updated server-side the instant this request
            // starts, well before the zip finishes streaming) would
            // otherwise stay stale until a manual refresh.
            form?.addEventListener('submit', () => {
              setTimeout(() => window.location.reload(), 1200);
            });
          })();
        </script>
      {% else %}
        <p class="notice notice-info">Indisponible sur cette instance — aucun exe préconstruit trouvé (variable <code>RELEASE_ASSETS_DIR</code> non configuree, ou dossier vide).</p>
      {% endif %}
    </div>

    <div class="panel top-gap">
      <div class="panel-heading">
        <div>
          <h3>Licence</h3>
          <p class="muted">
            L'exécutable livré à l'école tourne sur sa propre base de données, séparée de celle-ci — rien ici ne se synchronise automatiquement avec lui. Si une date d'expiration est choisie au téléchargement ci-dessus, la licence est déjà active au premier démarrage, sans aucune action côté école ; sans date, le pack part sans limite, à decider plus tard. Pour un <strong>renouvellement</strong> plus tard : régénérez et redonnez un nouveau pack (plus simple), ou générez un code avec <code>npm run license -- generate</code> en utilisant le secret ci-dessous (voir docs/deploiement-offline.md).
          </p>
        </div>
      </div>

      {% if provisioningLicenseSecret %}
        <label>Secret de licence de cette école
          <div class="inline-form no-wrap">
            <input type="text" id="provisioning-secret-field" value="{{ provisioningLicenseSecret }}" readonly />
            <button type="button" class="button secondary btn-sm" data-copy-target="provisioning-secret-field">Copier</button>
          </div>
        </label>
        <p class="muted" style="margin:6px 0 0;">À enregistrer une fois avec <code>npm run license -- set-secret "Nom de l'école" {{ provisioningLicenseSecret }}</code>, puis réutilisable pour chaque renouvellement — voir docs/deploiement-offline.md.</p>
      {% else %}
        <p class="notice notice-info">Aucun secret généré pour l'instant — téléchargez le pack d'installation ci-dessus une première fois pour en créer un.</p>
      {% endif %}
    </div>
  {% endif %}

  <section class="grid cols-2">
    <div class="panel">
      <div class="panel-heading">
        <div>
          <h2>{% if editEcole %}Modifier l'école{% else %}Nouvelle école{% endif %}</h2>
          <p class="muted">
            {% if editEcole %}
              Mettez à jour les informations de {{ editEcole.nom }}.
            {% else %}
              Crée un nouvel établissement avec ses propres données, isolées de toutes les autres écoles. Un compte administrateur est généré automatiquement pour son équipe.
            {% endif %}
          </p>
        </div>
      </div>
      <form method="post" action="{% if editEcole %}/platform/ecoles/{{ editEcole._id }}{% else %}/platform/ecoles{% endif %}" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

        <div class="form-section">
          <span class="form-section-title">Identité de l'établissement</span>
          <div class="form-grid">
            <label>Nom<input name="nom" value="{{ editEcole.nom }}" required /></label>
            <label>Ministere de tutelle<input name="ministereTutelle" value="{{ editEcole.ministereTutelle }}" /></label>
            <label>DRE<input name="dre" value="{{ editEcole.dre }}" /></label>
            <label>Inspection<input name="inspection" value="{{ editEcole.inspection }}" /></label>
            <label>Logo
              <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/gif" />
              {% if editEcole.logo %}
                <img src="/uploads/{{ editEcole.logo }}" alt="Logo actuel" style="height:48px;display:block;margin-top:4px;" />
              {% endif %}
            </label>
          </div>
        </div>

        <div class="form-section">
          <span class="form-section-title">Coordonnees</span>
          <div class="form-grid">
            <label>Email<input type="email" name="email" value="{{ editEcole.email }}" /></label>
            <label>Contact<input name="contact" value="{{ editEcole.contact }}" /></label>
            <label>Localite<input name="localite" value="{{ editEcole.localite }}" /></label>
          </div>
        </div>

        {% if not editEcole %}
          <div class="form-section">
            <span class="form-section-title">Compte administrateur</span>
            <p class="form-section-desc">Ce compte permet à l'équipe de l'école de se connecter dès la création - les identifiants générés seront affichés une seule fois, juste après l'enregistrement.</p>
            <div class="form-grid">
              <label>Nom de l'administrateur<input name="adminName" required /></label>
              <label>Email de l'administrateur<input type="email" name="adminEmail" required /></label>
            </div>
          </div>

          <div class="form-section">
            <span class="form-section-title">Modules activés à la création</span>
            <p class="form-section-desc">Modifiable ensuite depuis la fiche de l'école.</p>
            <div class="grid cols-2">
              <label class="toggle-option"><input type="checkbox" name="activateFinance" value="true" /> Module Finance</label>
              <label class="toggle-option"><input type="checkbox" name="activateBulletins" value="true" /> Module Bulletins</label>
            </div>
          </div>
        {% endif %}

        <div class="form-section">
          <span class="form-section-title">Personnalisation visuelle</span>
          <p class="form-section-desc">Ces couleurs apparaissent sur les cartes scolaires et les bulletins générés pour cette école - avec le logo, c'est ce qui permet de distinguer chaque établissement d'un coup d'oeil.</p>
          <div class="grid cols-2">
            <div class="color-field">
              <input type="color" name="couleurCarte" id="couleurCarte-input" value="{{ editEcole.couleurCarte or '#eef2fb' }}" {% if not editEcole.couleurCarte %}disabled{% endif %} />
              <label for="couleurCarte-toggle" class="toggle-option">
                <input type="checkbox" id="couleurCarte-toggle" name="couleurCartePersonnalisee" value="true" {% if editEcole.couleurCarte %}checked{% endif %} />
                Couleur de la carte scolaire
              </label>
            </div>
            <div class="color-field">
              <input type="color" name="couleurBulletin" id="couleurBulletin-input" value="{{ editEcole.couleurBulletin or '#1a3d8f' }}" {% if not editEcole.couleurBulletin %}disabled{% endif %} />
              <label for="couleurBulletin-toggle" class="toggle-option">
                <input type="checkbox" id="couleurBulletin-toggle" name="couleurBulletinPersonnalisee" value="true" {% if editEcole.couleurBulletin %}checked{% endif %} />
                Couleur des bulletins
              </label>
            </div>
          </div>
        </div>


        <div class="toolbar compact-actions">
          <button type="submit">{% if editEcole %}Mettre à jour{% else %}Enregistrer{% endif %}</button>
          {% if editEcole %}<a class="button secondary" href="/platform/ecoles">Annuler</a>{% endif %}
        </div>
      </form>
      <script>
        (() => {
          const bindColorToggle = (toggleId, inputId) => {
            const toggle = document.getElementById(toggleId);
            const input = document.getElementById(inputId);
            toggle?.addEventListener('change', () => {
              input.disabled = !toggle.checked;
            });
          };
          bindColorToggle('couleurCarte-toggle', 'couleurCarte-input');
          bindColorToggle('couleurBulletin-toggle', 'couleurBulletin-input');
        })();
      </script>
    </div>

    <div class="panel">
      <div class="panel-heading">
        <div>
          <h2>Écoles</h2>
          <p class="muted">Établissements clients de la plateforme.</p>
        </div>
      </div>
      <div class="table-shell">
        <table class="table-report">
          <thead>
            <tr><th>N°</th><th>Nom</th><th>Localite</th><th>Statut</th><th>Inscription</th><th>Actions</th></tr>
          </thead>
          <tbody>
            {% for item in ecoles %}
              <tr>
                <td>{{ loop.index }}</td>
                <td>{{ item.nom }}</td>
                <td>{{ item.localite }}</td>
                <td>{% set value = item.statutCompte %}{% set group = 'ecoleAccountStatus' %}{% include "partials/status-badge.njk" %}</td>
                <td>{{ item.dateInscription | formatDay }}</td>
                <td>
                  <div class="table-actions">
                    <a class="button btn-sm" href="/platform/ecoles/{{ item._id }}/edit">Modifier</a>
                    <a class="button btn-sm secondary" href="/platform/ecoles/{{ item._id }}/dashboard">Tableau de bord</a>
                    <a class="button btn-sm secondary" href="/platform/facturation/{{ item._id }}">Facturation</a>
                    <form method="post" action="/platform/ecoles/{{ item._id }}/status" class="inline-form no-wrap">
                      <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                      <select name="statutCompte">
                        {% for key, meta in ENUM_META.ecoleAccountStatus %}
                          <option value="{{ key }}" {% if item.statutCompte == key %}selected{% endif %} title="{{ meta.description }}">{{ meta.label }}</option>
                        {% endfor %}
                      </select>
                      <button type="submit" class="secondary btn-sm">Statut</button>
                    </form>
                  </div>
                </td>
              </tr>
            {% else %}
              <tr><td colspan="6">Aucune école.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {{ legend.render(['ecoleAccountStatus']) }}
    </div>
  </section>
{% endblock %}
