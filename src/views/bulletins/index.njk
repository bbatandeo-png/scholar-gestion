{% extends "layout.njk" %}
{% import "partials/legend.njk" as legend %}
{% block content %}
<div class="panel">
  {# La fiche de notes vierge et les statistiques ont leurs entrees dans le
     menu (Gestion pedagogique) : ici, de simples raccourcis. #}
  <div class="panel-heading">
    <p class="muted">Une session par classe et par période : saisissez ou importez les notes, puis validez-les pour produire les bulletins.</p>
    <div class="panel-heading-actions">
      <a class="button ghost btn-sm" href="/reports/grade-sheet">Fiche de notes vierge</a>
      <a class="button ghost btn-sm" href="/reports/exam-statistics">Statistiques</a>
      {% if currentUser and currentUser.role in ['super_admin', 'direction', 'secretariat'] %}<a class="button" href="/bulletins/new">+ Nouvelle session</a>{% endif %}
    </div>
  </div>
  <div class="table-shell">
    <table class="table-report">
      <thead>
        <tr><th>N°</th><th>Classe</th><th>Année scolaire</th><th>Période</th><th>Statut</th><th><span class="sr-only">Actions</span></th></tr>
      </thead>
      <tbody>
        {% for item in sessions %}
          <tr>
            <td>{{ loop.index }}</td>
            <td>{{ item.levelId.label }}</td>
            <td>{{ item.schoolYearId.label }}</td>
            <td>{{ periodeLabels[item.periode] }}</td>
            <td>{% set value = item.status %}{% set group = 'bulletinSessionStatus' %}{% include "partials/status-badge.njk" %}</td>
            <td>
              <div class="table-actions">
                <a class="button btn-sm" href="/bulletins/{{ item._id }}">Ouvrir</a>
                {% if item.status != 'draft' %}
                  <a class="button btn-sm secondary" href="/bulletins/{{ item._id }}/donnees">Données</a>
                {% endif %}
              </div>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="6">Aucune session de bulletins. Créez la première avec « + Nouvelle session ».</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {{ legend.render(['bulletinSessionStatus']) }}
</div>
{% endblock %}
