{% extends "layout.njk" %}
{% block content %}
  <section class="panel">
    {# Pas de second titre : le titre de la page est deja dans l'en-tete. #}
    <div class="panel-heading">
      <p class="muted">Répartition des moyennes par matière et effectifs inscrits, présents et admis par sexe, pour l'inspection. Année scolaire ouverte : <strong>{{ activeYear.label }}</strong>.</p>
    </div>

    <form method="get" action="/reports/exam-statistics" class="filter-bar" role="search">
      <label>Période
        <select name="periode" required>
          <option value="">Choisir une période</option>
          {% for key, meta in ENUM_META.periode %}
            <option value="{{ key }}" {% if periode == key %}selected{% endif %}>{{ meta.label }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Classe
        <select name="levelId">
          <option value="">Toutes les classes</option>
          {% for level in levels %}
            <option value="{{ level._id }}" {% if levelId == level._id %}selected{% endif %}>{{ level.label }}</option>
          {% endfor %}
        </select>
      </label>
      <button type="submit" class="button btn-icon icon-search">Afficher</button>
      <span class="filter-bar-separator" aria-hidden="true"></span>
      <button type="submit" formaction="/reports/exam-statistics/pdf" formtarget="_blank" class="button secondary btn-icon icon-export">Télécharger en PDF</button>
      <button type="submit" formaction="/reports/exam-statistics/excel" class="button secondary btn-icon icon-export">Télécharger en Excel</button>
      <button type="submit" formaction="/reports/exam-statistics/docx" class="button ghost btn-icon icon-export">Word</button>
    </form>

    {% if not report %}
      <div class="empty-state">
        <strong>Choisissez une période pour afficher les statistiques.</strong>
        <span>Laissez « Toutes les classes » pour une vue d'ensemble de l'établissement, ou choisissez une classe précise. Vous pouvez aussi télécharger directement le PDF ou le fichier Excel.</span>
      </div>
    {% endif %}

    {% if report %}
      <h3 class="top-gap">Répartition des moyennes par matière</h3>
      <p class="muted">Classe : <strong>{{ report.levelName }}</strong> — Période : <strong>{{ report.periodeLabel }}</strong></p>
      <div class="table-shell">
        <table class="table-report stats-table">
          <thead>
            <tr>
              <th>Matières</th>
              <th>Note &lt;5</th>
              <th>Note &lt;8</th>
              <th>Note &lt;10</th>
              <th>Note &lt;12</th>
              <th>Note &lt;14</th>
              <th>Note &lt;16</th>
              <th>Note &lt;18</th>
              <th>Note &lt;=20</th>
              <th>Nb moyennes (&gt;=10)</th>
              <th>% réussite</th>
            </tr>
          </thead>
          <tbody>
            {% for subject in report.subjects %}
              <tr>
                <td>{{ subject.label }}</td>
                <td>{{ subject.lt5 }}</td>
                <td>{{ subject.lt8 }}</td>
                <td>{{ subject.lt10 }}</td>
                <td>{{ subject.lt12 }}</td>
                <td>{{ subject.lt14 }}</td>
                <td>{{ subject.lt16 }}</td>
                <td>{{ subject.lt18 }}</td>
                <td>{{ subject.lte20 }}</td>
                <td>{{ subject.passCount }}</td>
                <td>{{ subject.successRate }}%</td>
              </tr>
            {% else %}
              <tr><td colspan="11">Aucune note validée pour cette période.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <h3 class="top-gap">Statistiques générales</h3>
      <div class="table-shell">
        <table class="table-report stats-table" data-no-filter>
          <thead>
            <tr>
              <th colspan="3">Inscrits</th>
              <th colspan="3">Présents</th>
              <th colspan="3">Admis</th>
              <th colspan="3">Pourcentage de réussite</th>
            </tr>
            <tr>
              {% for group in range(4) %}
                <th>Garçons</th><th>Filles</th><th>Total</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>{{ report.inscrits.g }}</td>
              <td>{{ report.inscrits.f }}</td>
              <td>{{ report.inscrits.t }}</td>
              <td>{{ report.presents.g }}</td>
              <td>{{ report.presents.f }}</td>
              <td>{{ report.presents.t }}</td>
              <td>{{ report.admis.g }}</td>
              <td>{{ report.admis.f }}</td>
              <td>{{ report.admis.t }}</td>
              <td>{{ report.successRate.g }}%</td>
              <td>{{ report.successRate.f }}%</td>
              <td>{{ report.successRate.t }}%</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="field-hint top-gap">{{ legend }}</p>
    {% endif %}
  </section>
{% endblock %}
